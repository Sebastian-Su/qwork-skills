  "expected_outcomes": [
    "expect(trigger).toBeVisible()",
    "expect(menu).toBeVisible()",
    "expect.soft(trigger.locator(\"svg\")).toHaveCSS(\"transform\", \"matrix(-1, 0, 0, -1, 0, 0)\")",
