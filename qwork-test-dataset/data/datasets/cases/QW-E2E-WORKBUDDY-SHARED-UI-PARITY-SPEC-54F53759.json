    "expect.soft(menu).toHaveCSS(\"background-color\", name === \"浅色\" ? \"rgb(255, 255, 255)\" : \"rgb(31, 31, 31)\")",
    "expect.soft((await menu.boundingBox())!.y - ((await trigger.boundingBox())!.y + 30)).toBe(4)",
    "expect.poll(() => page.evaluate(() => document.getAnimations().filter(a => a.effect?.getTiming().iterations !== Infinity && ![\"finished\", \"idle\"].includes(a.playState), ).length)).toBe(0)",
