  "expected_outcomes": [
    "expect.soft(page.getByRole(\"heading\", { name: \"自动化任务模版\", exact: true })).toHaveCSS(\"color\", primary, { timeout: 300 })",
    "expect.soft(page.getByText(\"开启你的第一个自动化任务吧\", { exact: true })).toHaveCSS(\"color\", secondary, { timeout: 300 })",
    "expect.soft(page.locator('[data-icon=\"empty-alarm\"]')).toHaveCSS(\"color\", muted, { timeout: 300 })",
    "expect.soft(page.getByRole(\"tab\", { name: \"运行记录\", exact: true })).toHaveCSS(\"color\", secondary, { timeout: 300 })",
    "expect.soft(add).toHaveCSS(\"font-family\", /PingFang SC/, { timeout: 300 })",
    "expect.soft(caption).toHaveCSS(\"display\", \"flex\", { timeout: 300 })",
    "expect.soft(await caption.evaluate(el => [...el.childNodes].map(node => node.textContent))).toEqual([\"+ \", \"添加自动化\"])",
    "expect.soft(await add.boundingBox()).toEqual({ x: 942.4296875, y: 391, width: 107.1328125, height: 32 })",
    "expect.soft(add).toHaveCSS(\"background-color\", mode === \"浅色\" ? \"rgba(0, 0, 0, 0.75)\" : \"rgba(255, 255, 255, 0.75)\", { timeout: 300 })",
    "expect.soft(add).toHaveCSS(\"background-color\", mode === \"浅色\" ? \"rgba(0, 0, 0, 0.9)\" : \"rgba(255, 255, 255, 0.9)\", { timeout: 300 })",
    "expect(page.getByRole(\"textbox\", { name: \"名称\", exact: true })).toBeVisible()"
  ],
