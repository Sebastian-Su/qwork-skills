  "expected_outcomes": [
    "expect(motion).toHaveAttribute(\"data-motion-renderer\", \"source-mesh\")",
    "expect(motion).toHaveAttribute(\"data-frame-ready\", \"true\")",
    "expect(motion).toHaveAttribute(\"data-frame-ready\", \"true\")",
    "expect(motion).toHaveAttribute(\"data-response\", \"pat\")",
    "expect(pet.getByTestId(\"desktop-pet-art\")).toHaveCSS( \"transform\", \"none\", )",
    "expect(pet.getByRole(\"button\", { name: \"暂停计时\" })).toBeVisible()",
    "expect(pet.getByRole(\"button\", { name: \"继续计时\" })).toBeVisible()",
    "expect(layout.top).toBeGreaterThanOrEqual(0)",
    "expect(layout.left).toBeGreaterThanOrEqual(0)",
    "expect(layout.right).toBeLessThanOrEqual(layout.width)",
    "expect(layout.bottom).toBeLessThanOrEqual(layout.height)",
    "expect(layout.overflow).toBe(false)",
    "expect(pet.getByText(\"专注完成\", { exact: true })).toBeVisible()",
    "expect(pet.getByRole(\"button\", { name: \"结束计时\" })).toBeVisible()",
    "expect.poll(() => running!.app.windows().length).toBeGreaterThan(1)",
    "expect( restored.getByRole(\"button\", { name: \"结束计时\" }), ).toBeVisible()",
    "expect( restored.getByRole(\"switch\", { name: \"免打扰\" }), ).toBeChecked()",
    "expect(restoredMotion).toHaveAttribute(\"data-frame-ready\", \"true\")",
    "expect(await restoredMotion.getAttribute(\"data-playhead\")).toBe(paused)",
    "expect .poll(() => restoredMotion.getAttribute(\"data-playhead\")) .not.toBe(paused)",
    "expect( restored.getByTestId(\"desktop-pet-source-fallback\"), ).toBeVisible()",
    "expect(restoredMotion).toHaveAttribute( \"data-motion-renderer\", \"source-video-fallback\", )",
    "expect(restoredMotion).toHaveAttribute(\"data-frame-ready\", \"true\")"
