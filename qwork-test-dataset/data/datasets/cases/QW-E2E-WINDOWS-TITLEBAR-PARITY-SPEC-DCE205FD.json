    "expect(opened.page.getByRole(\"toolbar\", { name: \"对话工具栏\" })).toHaveCount(0)",
    "expect(opened.page.getByRole(\"button\", { name })).toBeVisible()",
    "expect(opened.page.getByRole(\"combobox\", { name: \"历史提问\" })).toBeVisible()",
    "expect(opened.page.getByRole(\"button\", { name })).toHaveCount(0)",
