    "expect(sidebarBox).not.toBeNull()",
    "expect(toolbarBox).not.toBeNull()",
    "expect(toolbarBox!.x).toBeGreaterThanOrEqual(sidebarBox!.x + sidebarBox!.width + 8)",
    "expect(sidebarBox).not.toBeNull()",
    "expect(headingBox).not.toBeNull()",
    "expect(headingBox!.y).toBeGreaterThanOrEqual(sidebarBox!.y + sidebarBox!.height + 8)",
    "expect(Math.abs(geometry.viewportWidth - 1159)).toBeLessThanOrEqual(2)",
    "expect(Math.abs(geometry.brand.x - 4)).toBeLessThanOrEqual(2)",
    "expect(geometry.brand.y).toBe(0)",
    "expect(Math.abs(geometry.brand.height - 30)).toBeLessThanOrEqual(2)",
    "expect(Math.abs(geometry.edit.x - (geometry.brand.x + geometry.brand.width))).toBeLessThanOrEqual(2)",
    "expect(Math.abs(geometry.window.x - (geometry.edit.x + geometry.edit.width))).toBeLessThanOrEqual(2)",
    "expect(Math.abs(geometry.help.x - (geometry.window.x + geometry.window.width))).toBeLessThanOrEqual(2)",
    "expect(geometry.controls).toHaveLength(0)",
    "expect(Math.abs(geometry.nativeControlsReserve.x - (geometry.viewportWidth - 138))).toBeLessThanOrEqual(2)",
    "expect(Math.abs(geometry.nativeControlsReserve.width - 138)).toBeLessThanOrEqual(2)",
    "expect(Math.abs(geometry.nativeControlsReserve.height - 30)).toBeLessThanOrEqual(2)",
    "expect(button).toHaveCSS(\"white-space\", \"nowrap\")",
    "expect(buttonBox).not.toBeNull()",
