  "expected_outcomes": [
    "expect(chrome).toHaveAttribute(\"data-windows-qwork-titlebar\", \"true\")",
    "expect(chrome).toHaveCSS(\"height\", \"30px\")",
    "expect(opened.page.getByTestId(\"windows-brand-menu\")).toHaveText(\"QWork\")",
    "expect(opened.page.getByRole(\"button\", { name: \"编辑(E)\" })).toBeVisible()",
    "expect(opened.page.getByRole(\"button\", { name: \"窗口(W)\" })).toBeVisible()",
    "expect(opened.page.getByRole(\"button\", { name: \"帮助(H)\" })).toBeVisible()",
    "expect(chrome.getByRole(\"button\", { name: \"文件\" })).toHaveCount(0)",
    "expect(chrome.getByRole(\"button\", { name: \"查看\" })).toHaveCount(0)",
    "expect(chrome.getByRole(\"toolbar\")).toHaveCount(0)",
    "expect(pageToolbar).toHaveCount(0)",
    "expect(pageToolbar).toBeVisible()",
    "expect.poll(async () => (await pageToolbar.boundingBox())?.y).toBe(30)",
    "expect(opened.page.getByRole(\"toolbar\", { name: \"对话工具栏\" })).toHaveCount(0)",
    "expect(opened.page.getByRole(\"button\", { name })).toBeVisible()",
    "expect(opened.page.getByRole(\"combobox\", { name: \"历史提问\" })).toBeVisible()",
    "expect(opened.page.getByRole(\"button\", { name })).toHaveCount(0)",
    "expect(sidebarControls.locator(\"button\")).toHaveCount(destination === \"项目\" ? 1 : 2)",
    "expect(pageToolbar).toHaveCount(0)",
    "expect(sidebarBox).not.toBeNull()",
    "expect(toolbarBox).not.toBeNull()",
    "expect(toolbarBox!.x).toBeGreaterThanOrEqual(sidebarBox!.x + sidebarBox!.width + 8)",
    "expect(sidebarBox).not.toBeNull()",
    "expect(headingBox).not.toBeNull()",
    "expect(headingBox!.y).toBeGreaterThanOrEqual(sidebarBox!.y + sidebarBox!.height + 8)",
    "expect(Math.abs(geometry.viewportWidth - 1159)).toBeLessThanOrEqual(2)",
    "expect(geometry.brand).toEqual({ x: 0, y: 0, width: 92, height: 30 })",
    "expect(geometry.edit).toEqual({ x: 92, y: 0, width: 55, height: 30 })",
    "expect(geometry.window).toEqual({ x: 147, y: 0, width: 58, height: 30 })",
    "expect(geometry.help).toEqual({ x: 205, y: 0, width: 62, height: 30 })",
    "expect(geometry.controls).toHaveLength(3)",
    "geometry.controls.forEach((control, index) => { expect(control).toMatchObject({ y: 0, width: 46, height: 30 }); const expectedX = geometry.viewportWidth - (3 - index) * 46; expect(Math.abs(control.x - expectedX)).toBeLessThanOrEqual(2); })",
    "expect(button).toHaveCSS(\"white-space\", \"nowrap\")",
    "expect.poll(async () => (await button.boundingBox())?.height).toBe(30)"
  ],
