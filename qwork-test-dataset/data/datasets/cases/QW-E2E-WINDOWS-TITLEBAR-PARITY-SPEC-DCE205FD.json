    "expect(opened.page.getByRole(\"menuitem\", { name: \"编辑(E)\" })).toBeVisible()",
    "expect(opened.page.getByRole(\"menuitem\", { name: \"窗口(W)\" })).toBeVisible()",
    "expect(opened.page.getByRole(\"menuitem\", { name: \"帮助(H)\" })).toBeVisible()",
    "expect(globalChrome.getByRole(\"menuitem\", { name: \"文件\" })).toHaveCount(0)",
