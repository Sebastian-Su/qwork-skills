    "expect(expandBox).not.toBeNull()",
    "expect(expandBox).toMatchObject({ x: 16, y: 42, width: 32, height: 32 })",
    "expect(newThreadBox).toMatchObject({ x: 52, y: 42, width: 32, height: 32 })",
