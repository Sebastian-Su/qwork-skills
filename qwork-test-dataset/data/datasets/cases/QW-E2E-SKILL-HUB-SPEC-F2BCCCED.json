  "expected_outcomes": [
    "expect(page.getByRole(\"tab\", { name: \"SkillHub\", exact: true })).toBeVisible()",
    "expect(page.getByRole(\"tab\", { name: \"推荐\", exact: true })).toHaveAttribute( \"aria-selected\", \"true\", )",
    "expect(page.getByText(\"公众号爆款封面设计\", { exact: true })).toHaveCount(0)",
    "expect(page.getByRole(\"tab\", { name: \"办公效率\", exact: true })).toBeVisible()",
    "expect(weatherCard).toBeVisible()",
    "expect(page.getByRole(\"heading\", { name: \"Weather\", level: 1 })).toBeVisible()",
    "expect(page.getByTestId(\"skill-detail-source\")).toContainText(/name:\\s*[\"']?Weather[\"']?/)",
    "expect( page.getByRole(\"status\").filter({ hasText: \"「Weather」技能已安装，去试试\" }), ).toContainText(\"「Weather」技能已安装，去试试\")",
    "expect.poll(async () => fs.readdir(path.join(configHome, \"skills\"))).toContain(\"weather__skillhub\")",
    "expect(page.getByText(/description: weather/)).toBeVisible()",
    "expect(page.getByRole(\"button\", { name: \"打开文件夹\" })).toBeVisible()",
    "expect(page.getByRole(\"button\", { name: \"卸载\", exact: true })).toBeVisible()",
    "expect(page.getByRole(\"button\", { name: \"检查并更新\" })).toHaveCount(0)",
    "expect(page.getByTestId(\"skill-detail-metadata\")).toContainText(\"description\")",
    "expect(page.getByTestId(\"skill-detail-preview\")).toContainText(\"Weather\")",
    "expect(catalogMenu.getByRole(\"menuitem\", { name: \"关闭\" })).toBeVisible()",
    "expect(catalogMenu.getByRole(\"menuitem\", { name: \"卸载\" })).toBeVisible()",
    "expect(catalogMenu.getByText(\"编辑\", { exact: true })).toHaveCount(0)",
    "expect(page.getByRole(\"status\").filter({ hasText: \"Weather 已关闭自动触发\" })).toHaveCount(1)",
    "expect(page.getByTestId(\"skill-card-content\")).not.toHaveClass(/opacity-45/)",
    "expect(page.getByTestId(\"skill-card\")).toHaveCSS(\"background-color\", \"rgb(255, 255, 255)\")",
    "expect(page.getByTestId(\"skill-card-avatar\")).toHaveCSS(\"opacity\", \"0.35\")",
    "expect(page.getByTestId(\"skill-card-title\")).toHaveCSS(\"opacity\", \"0.55\")",
    "expect(page.getByTestId(\"skill-card-description\")).toHaveCSS(\"opacity\", \"0.55\")",
    "expect(page.getByRole(\"button\", { name: \"Weather 已安装\" })).toHaveCSS(\"opacity\", \"1\")",
    "expect(page.getByRole(\"button\", { name: \"Weather 已安装\" })).toHaveCSS(\"background-color\", \"rgba(0, 0, 0, 0)\")",
    "expect(page.getByRole(\"status\").filter({ hasText: \"Weather 已开启自动触发\" })).toHaveCount(1)",
    "expect(page.getByTestId(\"skill-card-content\")).not.toHaveClass(/opacity-45/)",
    "expect(page.getByTestId(\"skill-card-avatar\")).toHaveCSS(\"opacity\", \"1\")",
    "expect(page.getByTestId(\"skill-card-title\")).toHaveCSS(\"opacity\", \"1\")",
    "expect(page.getByTestId(\"skill-card-description\")).toHaveCSS(\"opacity\", \"1\")",
    "expect(autoTriggerToasts).toHaveText([ \"Weather 已关闭自动触发\", \"Weather 已开启自动触发\", \"Weather 已关闭自动触发\", ])",
    "expect(page.getByTestId(\"skill-card-content\")).not.toHaveClass(/opacity-45/)",
    "expect(page.getByRole(\"heading\", { name: \"我安装的\", level: 1 })).toBeVisible()",
    "expect(page.getByPlaceholder(\"搜索已安装的技能\")).toBeVisible()",
    "expect(page.getByRole(\"tablist\", { name: \"技能来源\" })).toHaveCount(0)",
    "expect(installedSwitch).toBeChecked()",
    "expect(page.getByRole(\"switch\", { name: \"启用 Weather\" })).not.toBeChecked()",
    "expect.poll(async () => page.evaluate(async () => (await window.workGui.skills.scanManaged()).some((item) => item.id === \"Weather\"), )).toBe(false)",
    "expect(page.getByRole(\"switch\", { name: \"停用 Weather\" })).toBeChecked()",
    "expect(installedCardStyle[\"background-color\"]).not.toBe(\"rgba(0, 0, 0, 0)\")",
    "expect(installedCardStyle[\"box-shadow\"]).not.toBe(\"none\")",
    "expect(installedToggleBox.x - installedBadgeBox.right).toBeLessThanOrEqual(installedToggleBox.width * 2.25)",
    "expect(installedDescriptionBox.right).toBeGreaterThanOrEqual(installedToggleBox.x)",
    "expect(installedDescriptionTooltip).toHaveText(\"Get current weather and forecasts (no API key required).\")",
    "expect(installedDescriptionTooltip).toHaveCount(0)",
    "expect(installedMenu.getByRole(\"menuitem\", { name: \"去对话\" })).toBeVisible()",
    "expect(installedMenu.getByRole(\"menuitem\", { name: \"打开文件夹\" })).toBeVisible()",
    "expect(installedMenu.getByRole(\"menuitem\", { name: \"卸载\" })).toBeVisible()",
    "expect(installedMenu.getByText(\"编辑\", { exact: true })).toHaveCount(0)",
    "expect(composer).toHaveValue(\"\")",
    "expect( page.getByRole(\"button\", { name: \"默认权限\", exact: true }), ).toBeVisible()",
    "expect(selectedSkillChip).toBeVisible()",
    "expect(darkChipBackground).not.toBe(lightChipBackground)",
    "expect(accountMenuButton).toHaveAttribute(\"aria-expanded\", \"false\")",
    "expect(page.locator(\".message-copy\", { hasText: \"查询北京天气\" })).toHaveCount(0)",
    "expect(page.getByText(\"收到：@Weather 查询北京天气\", { exact: true })).toBeVisible()",
    "expect.poll(() => selectedSkillsFromLog(sidecarLog)).toEqual([ \"Weather\", ])",
    "expect.poll(() => userMessagesFromLog(sidecarLog)).toContainEqual( expect.stringMatching(/@Weather\\s+[\\s\\S]*查询北京天气/), )",
    "expect( page.getByRole(\"button\", { name: \"默认权限\", exact: true }), ).toBeVisible()"
  ],
