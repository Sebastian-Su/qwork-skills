  "expected_outcomes": [
    "expect(page.getByText(/本地模板生成失败：.*studio_coordinates_are_not_allowed/)).toBeVisible({ timeout: 30_000 })",
    "expect(page.getByRole(\"button\", { name: \"打开产出物 归档培训.pptx\" })).toHaveCount(0)",
    "expect(page.getByText(/本地模板生成失败：.*content_overflow/).last()).toContainText(field, { timeout: 10_000 })",
    "expect(page.getByRole(\"button\", { name: \"打开产出物 归档培训.pptx\" })).toHaveCount(0)",
    "expect(page.getByRole(\"tab\", { name: \"template-generated.pptx\", exact: true })).toBeVisible({ timeout: 15_000 })",
    "expect(page.getByLabel(\"PPTX 编辑器\")).toBeVisible({ timeout: 30_000 })",
    "expect(page.getByLabel(\"Slide 1 of 1\", { exact: true })).toBeVisible({ timeout: 30_000 })",
    "expect(page.getByRole(\"button\", { name: \"打开产出物 归档培训.pptx\" })).toHaveCount(0)",
    "expect(page.getByLabel(`Slide 1 of ${count}`, { exact: true })).toBeVisible({ timeout: 20_000 })",
    "expect(page.getByRole(\"button\", { name: \"打开产出物 归档培训.pptx\" })).toBeVisible({ timeout: 75_000 })",
    "expect(inspected.status, inspected.stderr).toBe(0)",
    "expect(inspected.stdout.trim()).toBe(\"True\")",
    "expect(journal.map((entry) => entry.slides)).toEqual([1, 2, 3, 4, 5])",
    "expect(new Set(journal.map((entry) => entry.sha256)).size).toBe(5)",
    "expect(journal.map((entry) => entry.progress.completed)).toEqual([1, 2, 3, 4, 5])",
    "expect(journal.map((entry) => entry.composition)).toEqual([\"metric-comparison\", \"trend-insight\", \"funnel-insight\", \"swimlane-roadmap\", \"action-list\"])",
    "expect(journal.map((entry) => entry.review.status)).toEqual([\"passed\", \"passed\", \"passed\", \"passed\", \"passed\"])",
    "expect(page.getByLabel(\"PPTX 编辑器\")).toBeVisible({ timeout: 60_000 })",
    "expect(page.getByRole(\"application\", { name: \"Presentation slide editor\" })).toBeVisible()",
    "expect(page.getByText(/No slides/)).toHaveCount(0)",
    "expect(page.getByTestId(\"pptx-editor-toolbar\")).toBeVisible()",
    "expect(page.getByLabel(\"Slide 1 of 5\", { exact: true })).toBeVisible()",
    "expect.poll(() => comparisonCanvas.evaluate((element) => { const canvas = element as HTMLCanvasElement; const pixel = canvas.getContext(\"2d\")!.getImageData(canvas.width - 4, canvas.height - 20, 1, 1).data; return pixel[0] + pixel[1] + pixel[2]; })).toBeGreaterThan(700)",
    "expect.poll(() => comparisonCanvas.evaluate((element) => { const canvas = element as HTMLCanvasElement; const pixels = canvas.getContext(\"2d\")!.getImageData(Math.round(canvas.width * .05), Math.round(canvas.height * .2), Math.round(canvas.width * .9), Math.round(canvas.height * .65)).data; return Array.from(pixels).filter((value, index) => index % 4 !== 3 && value < 220).length; })).toBeGreaterThan(12_000)",
    "expect(trendCanvas).toBeVisible()",
    "expect.poll(() => trendCanvas.evaluate((element) => { const canvas = element as HTMLCanvasElement; const pixels = canvas.getContext(\"2d\")!.getImageData(0, Math.round(canvas.height * .3), canvas.width, Math.round(canvas.height * .45)).data; return Array.from(pixels).filter((value, index) => index % 4 !== 3 && value < 210).length; })).toBeGreaterThan(4000)",
    "expect(funnelCanvas).toBeVisible()",
    "expect.poll(() => roadmapCanvas.evaluate((element) => { const canvas = element as HTMLCanvasElement; const pixels = canvas.getContext(\"2d\")!.getImageData(0, Math.round(canvas.height * .3), canvas.width, Math.round(canvas.height * .5)).data; return Array.from(pixels).filter((value, index) => index % 4 !== 3 && value < 220).length; })).toBeGreaterThan(5000)",
    "expect(actionCanvas).toBeVisible()",
    "expect(actionInk).toBeGreaterThan(5000)"
