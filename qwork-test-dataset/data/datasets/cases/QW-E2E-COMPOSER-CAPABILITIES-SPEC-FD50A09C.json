  "expected_outcomes": [
    "expect(preloadedConnectorManager).toBeVisible()",
    "expect(preloadedIcons).toHaveCount(2)",
    "expect( page.getByRole(\"img\", { name: \"e2e-connected\", exact: true }), ).toBeVisible()",
    "expect( page.getByRole(\"img\", { name: \"e2e-connected-two\", exact: true }), ).toBeVisible()",
    "expect(connectorSwitch).toHaveAttribute(\"aria-checked\", \"true\")",
    "expect( page.getByLabel(\"当前对话连接器\", { exact: true }).getByRole(\"img\", { name: \"e2e-connected\", exact: true, }), ).toBeVisible()",
    "expect(activeConnectorIcons).toHaveCount(2)",
    "expect(firstIcon).not.toBeNull()",
    "expect(secondIcon).not.toBeNull()",
    "expect(secondIcon!.x).toBeLessThan(firstIcon!.x + firstIcon!.width)",
    "expect(connectorMenu).toBeHidden()",
    "expect(activeConnectorMenu).toHaveCSS(\"width\", \"206px\")",
    "expect(activeConnectorSwitches).toHaveCount(2)",
    "expect(activeConnectorSwitches.nth(0)).toHaveAttribute(\"aria-checked\", \"true\")",
    "expect(page.getByLabel(\"当前对话连接器\", { exact: true }).getByRole(\"img\")).toHaveCount(1)",
    "expect(page.getByLabel(\"当前对话连接器\", { exact: true }).getByRole(\"img\")).toHaveCount(2)",
    "expect(reopenedSwitch).toHaveAttribute(\"aria-checked\", \"false\")",
    "expect(reopenedSwitch).toHaveAttribute(\"aria-checked\", \"true\")",
    "expect(page.getByRole(\"status\", { name: \"连接器状态\" })).toHaveText( \"连接器 e2e-connected 已连接\", )",
    "expect(reopenedConnectorMenu).toBeVisible()",
    "expect(reopenedConnectorMenu).toBeHidden()",
    "expect(page.getByText(\"收到：使用当前对话连接器\", { exact: true })).toBeVisible()",
    "expect.poll(async () => { const saved = JSON.parse(await fs.readFile( path.join(home, \"qwork-session-selections.json\"), \"utf8\", )) as Record<string, { connectors?: string[] }>; return Object.values(saved).some((selection) => selection.connectors?.includes(\"e2e-connected\"), ); }).toBe(true)",
    "expect(refreshedConnectorMenu.getByRole(\"button\", { name: /取消连接 e2e-connected/ })) .toHaveCount(0)"
  ],
