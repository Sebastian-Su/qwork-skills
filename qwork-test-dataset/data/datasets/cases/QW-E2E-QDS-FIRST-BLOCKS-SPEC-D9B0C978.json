    "expect(page.getByTestId(\"settings-surface\")).toHaveCSS(\"height\", \"720px\")",
    "expect(page.getByTestId(\"settings-backdrop\")).toHaveCSS(\"z-index\", \"50\")",
    "expect(page.getByTestId(\"settings-layer\")).toHaveCSS(\"z-index\", \"60\")",
    "expect(dialog.getByRole(\"button\", { name: \"系统设置\", exact: true })).toHaveAttribute(\"aria-current\", \"page\")",
    "expect(dialog).not.toBeVisible()",
    "expect(tabs).toBeVisible()"
