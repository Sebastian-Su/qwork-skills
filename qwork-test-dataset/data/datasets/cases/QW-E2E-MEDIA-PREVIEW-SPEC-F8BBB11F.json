  "expected_outcomes": [
    "expect(video).toBeVisible()",
    "expect(video).toHaveAttribute(\"controls\", \"\")",
    "expect(video).toHaveAttribute(\"controlslist\", \"nofullscreen\")",
    "expect(video).toHaveAttribute(\"loop\", \"\")",
    "expect .poll(() => video.evaluate(() => { for (const sheet of Array.from(document.styleSheets)) { let rules: CSSRuleList; try { rules = sheet.cssRules; } catch { continue; } for (const rule of Array.from(rules)) { if ( rule instanceof CSSStyleRule && rule.selectorText === \".qwork-native-video-preview::-webkit-media-controls-fullscreen-button\" && rule.style.display === \"none\" ) { return true; } } } return false; }), …",
    "expect(video).toHaveJSProperty(\"paused\", true)",
    "expect.poll(() => video.evaluate((element: HTMLVideoElement) => element.duration)).toBeGreaterThan(0)",
    "expect.poll(() => video.evaluate((element: HTMLVideoElement) => element.currentTime)).toBeGreaterThan(0)",
    "expect(video).toHaveJSProperty(\"muted\", false)",
    "expect(video).toHaveJSProperty(\"volume\", 0.35)",
    "expect .poll(() => video.evaluate((element) => (element as HTMLVideoElement & { webkitAudioDecodedByteCount?: number }) .webkitAudioDecodedByteCount ?? 0, ), ) .toBeGreaterThan(0)",
    "expect.poll(() => video.evaluate((element: HTMLVideoElement) => element.currentTime)).toBeGreaterThan(0)"
  ],
