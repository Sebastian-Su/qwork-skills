  "expected_outcomes": [
    "uiExpect.soft(page.getByRole(\"heading\", { name: \"精选场景\", exact: true })).toBeVisible()",
    "uiExpect.soft(page.getByRole(\"article\").filter({ hasText: title })).toBeVisible()",
    "uiExpect.soft(sceneCards).toHaveCount(8)",
    "uiExpect.soft(await sceneCards.evaluateAll((cards) => cards.slice(0, 4).map((card) => card.querySelector(\"h2\")?.textContent))).toEqual([ \"开学季\", \"内容创作\", \"投资分析\", \"法律咨询\", ])",
    "uiExpect.soft((await computedStyle(firstScene, [\"border-radius\"]))[\"border-radius\"]).toBe(\"16px\")",
    "uiExpect.soft(sceneImages).toHaveCount(8)",
    "uiExpect.soft(await sceneImages.evaluateAll((images) => images.every((image) => image instanceof HTMLImageElement && image.naturalWidth > 0), )).toBe(true)",
    "uiExpect.soft(previous).toHaveCount(0)",
    "uiExpect.soft(next).toBeVisible()",
    "uiExpect.soft(arrowStyle[\"background-color\"]).toBe(\"rgba(255, 255, 255, 0.92)\")",
    "uiExpect.soft(arrowStyle[\"border-radius\"]).toBe(\"999px\")",
    "uiExpect.soft(arrowStyle[\"box-shadow\"]).toBe(\"rgba(0, 0, 0, 0.12) 0px 4px 14px 0px\")",
    "expect.poll(() => sceneList.evaluate((element) => element.scrollLeft)).toBeGreaterThanOrEqual(before + 258)",
    "uiExpect.soft(previous).toBeVisible()",
    "expect.poll(() => sceneList.evaluate((element) => element.scrollLeft)).toBeLessThanOrEqual(before + 1)",
    "uiExpect.soft(previous).toHaveCount(0)"
  ],
