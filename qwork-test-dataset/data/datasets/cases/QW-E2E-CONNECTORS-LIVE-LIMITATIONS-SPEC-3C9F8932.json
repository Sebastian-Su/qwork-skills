    "expect(dialog.getByRole(\"button\", { name: \"停用\", exact: true })).toBeVisible()",
    "expect(dialog.getByRole(\"button\", { name: \"停用\", exact: true })).toBeVisible()",
    "expect.poll(async () => (await readJsonLines(mcpLog)).filter( ({ type, server }) => type === \"mcp_server_upsert\" && (server as { name?: string } | undefined)?.name === \"cloudbase\", ).length, ).toBe(1)",
    "expect( dialog.getByRole(\"button\", { name: \"启用\", exact: true }), ).toBeVisible()",
    "expect.poll(async () => (await readJsonLines(mcpLog)).filter( ({ type, name }) => type === \"mcp_server_remove\" && name === \"cloudbase\", ).length, ).toBe(1)",
    "expect(page.getByText(\"收到：离线路由检查\", { exact: true })).toBeVisible()",
    "expect.poll(async () => { const record = (await readJsonLines(sidecarLog)).find( ({ type }) => type === \"user_message\", ); return JSON.stringify(record?.content ?? \"\"); }).toContain(\"CLI 连接器：tmeet\")",
