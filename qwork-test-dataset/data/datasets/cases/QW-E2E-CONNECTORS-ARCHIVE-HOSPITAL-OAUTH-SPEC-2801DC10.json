  "expected_outcomes": [
    "expect.poll(() => provider.registrationRequests).toHaveLength(1)",
    "expect(redirects).toEqual([expect.any(String)])",
    "expect( dcrRedirect, \"the shipped archive entry must register the provider's exact /oauth/callback loopback path\", ).toMatch(/^http:\\/\\/127\\.0\\.0\\.1:\\d+\\/oauth\\/callback$/)",
    "expect(provider.acceptedRedirect()).toBe(dcrRedirect)",
    "expect(registration).toMatchObject({ redirect_uris: [dcrRedirect], grant_types: [\"authorization_code\", \"refresh_token\"], response_types: [\"code\"], token_endpoint_auth_method: \"none\", application_type: \"native\", })",
    "expect(registration.client_name).toMatch(/^qwork-archive-hospital-mcp-/)",
    "expect.poll(async () => readLines(authUrlSink)).toHaveLength(1)",
    "expect(authorize.origin).toBe(provider.origin)",
    "expect(authorize.pathname).toBe(\"/oauth/authorize\")",
    "expect(authorizationRedirect).toBe(dcrRedirect)",
    "expect(authorize.searchParams.get(\"client_id\")).toBe(CLIENT_ID)",
    "expect(authorize.searchParams.get(\"scope\")).toBe(shipped.scopes.join(\" \"))",
    "expect(authorize.searchParams.get(\"resource\")).toBe( `${provider.origin}/mcp`, )",
    "expect(authorize.searchParams.get(\"code_challenge_method\")).toBe(\"S256\")",
    "expect(authorize.searchParams.get(\"code_challenge\")).toBeTruthy()",
    "expect(state).toBeTruthy()",
    "expect(authorizationRedirect).not.toMatch(/^(?:qwork|workbuddy):/i)",
    "expect(serializedAuthorize).not.toContain(\"qwork%3a\")",
    "expect(serializedAuthorize).not.toContain(\"workbuddy%3a\")",
    "expect(callbackResponse.status).toBe(200)",
    "expect.poll(() => provider.tokenRequests).toHaveLength(1)",
    "expect(tokenRequest.get(\"grant_type\")).toBe(\"authorization_code\")",
    "expect(tokenRequest.get(\"client_id\")).toBe(CLIENT_ID)",
    "expect(tokenRequest.get(\"redirect_uri\")).toBe(dcrRedirect)",
    "expect(tokenRequest.get(\"resource\")).toBe(`${provider.origin}/mcp`)",
    "expect(verifier).toBeTruthy()",
    "expect(createHash(\"sha256\").update(verifier!).digest(\"base64url\")).toBe( authorize.searchParams.get(\"code_challenge\"), )",
    "expect( detail.getByRole(\"button\", { name: \"停用\", exact: true }), ).toBeVisible()",
    "expect( page.getByRole(\"button\", { name: `${CONNECTOR_NAME}，已连接`, exact: true, }), ).toBeVisible()",
    "expect .poll(async () => (await readMcpLog(mcpLog)).find( (entry) => entry.type === \"mcp_server_upsert\" && (entry.server as { name?: string } | undefined)?.name === CONNECTOR_ID, ), ) .toBeTruthy()",
    "expect(upsert?.server).toEqual( expect.objectContaining({ name: CONNECTOR_ID, transport: \"http\", url: `${provider.origin}/mcp`, static_headers: { Authorization: `Bearer ${ACCESS_TOKEN}` }, }), )",
    "expect(await readLines(authUrlSink)).toHaveLength(1)"
  ],
