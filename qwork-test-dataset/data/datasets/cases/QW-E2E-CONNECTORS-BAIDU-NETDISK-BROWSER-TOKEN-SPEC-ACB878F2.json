  "expected_outcomes": [
    "expect.poll(async () => readLines(authUrlSink)).toEqual([AUTHORIZATION_URL])",
    "expect(form).toBeVisible()",
    "expect( form.getByRole(\"button\", { name: \"重新打开百度网盘授权页\" }), ).toBeVisible()",
    "expect(form.getByRole(\"alert\")).toContainText(\"授权结果无效\")",
    "expect(form.getByRole(\"alert\")).not.toContainText(REJECTED_TOKEN)",
    "expect(rejectedVault).not.toContain(REJECTED_TOKEN)",
    "expect(rejectedVault).not.toContain(rejectedCallback)",
    "expect(JSON.parse(rejectedVault)).toMatchObject({ data: { records: {} } })",
    "expect( await readTextIfPresent(path.join(connectorRoot, \"bridge-servers.json\")), ).not.toContain(REJECTED_TOKEN)",
    "expect(detail.getByRole(\"button\", { name: \"停用\", exact: true })).toBeVisible()",
    "expect(await readLines(authUrlSink)).toEqual([AUTHORIZATION_URL])",
    "expect(vault).not.toContain(TOKEN)",
    "expect(vault).not.toContain(CALLBACK)",
    "expect(state).not.toContain(TOKEN)",
    "expect(state).not.toContain(CALLBACK)",
    "expect(content, nonRuntimeFile).not.toContain(TOKEN)",
    "expect(content, nonRuntimeFile).not.toContain(CALLBACK)",
    "expect(bridge.mcpServers?.[\"baidu-netdisk\"]).toEqual( expect.objectContaining({ url: `https://mcp-pan.baidu.com/sse?access_token=${ENCODED_TOKEN}`, }), )",
    "expect(bridge.mcpServers?.[\"baidu-netdisk\"]?.headers).toBeUndefined()",
    "expect(bridge.mcpServers?.[\"baidu-netdisk\"]?.url).not.toContain(TOKEN)",
    "expect((await fs.stat(bridgePath)).mode & 0o777).toBe(0o600)",
    "expect(reopened.getByLabel(/授权结果或 Access Token/)).toHaveValue(\"\")",
    "expect(reopened.getByText(TOKEN, { exact: false })).toHaveCount(0)",
    "expect(await readLines(authUrlSink)).toEqual([AUTHORIZATION_URL])",
    "expect(detail.getByRole(\"button\", { name: \"启用\", exact: true })).toBeVisible()",
    "expect(disabledBridge.mcpServers?.[\"baidu-netdisk\"]).toBeUndefined()",
    "expect(detail.getByRole(\"button\", { name: \"停用\", exact: true })).toBeVisible()",
    "expect(enabledBridge.mcpServers?.[\"baidu-netdisk\"]).toEqual( expect.objectContaining({ url: `https://mcp-pan.baidu.com/sse?access_token=${ENCODED_TOKEN}`, }), )",
    "expect(enabledBridge.mcpServers?.[\"baidu-netdisk\"]?.headers).toBeUndefined()",
    "expect(page.getByRole(\"button\", { name: \"百度网盘，未连接\" })).toBeVisible()",
    "expect(unboundBridge.mcpServers?.[\"baidu-netdisk\"]).toBeUndefined()"
  ],
