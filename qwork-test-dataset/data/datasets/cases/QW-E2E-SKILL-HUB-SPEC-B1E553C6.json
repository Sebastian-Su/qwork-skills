  "expected_outcomes": [
    "expect(categoryRail.getByRole(\"tab\", { name: \"生活服务\", exact: true })).toHaveCount(1)",
    "expect(categoryStyle[\"overflow-x\"]).toBe(\"auto\")",
    "expect(categoryStyle[\"scrollbar-width\"]).toBe(\"none\")",
    "expect.poll(async () => ( categoryRail.getByRole(\"tab\", { name: \"办公效率\", exact: true }).evaluate( (element) => getComputedStyle(element).backgroundColor, ) )).not.toBe(\"rgba(0, 0, 0, 0)\")",
    "expect(scrollPosition.scrollWidth).toBeGreaterThan(scrollPosition.clientWidth)",
    "expect(scrollPosition.left).toBeGreaterThan(0)",
    "expect(cards).toHaveCount(30)",
    "expect(first.width).toBeGreaterThanOrEqual(290)",
    "expect(first.width).toBeLessThanOrEqual(380)",
    "expect(first.height).toBeGreaterThanOrEqual(124)",
    "expect(first.height).toBeLessThanOrEqual(128)",
    "expect(Math.abs(first.y - second.y)).toBeLessThanOrEqual(2)",
    "expect(second.x - first.right).toBeGreaterThanOrEqual(10)",
    "expect(second.x - first.right).toBeLessThanOrEqual(14)",
    "expect(firstCardStyle[\"background-color\"]).toBe(\"rgb(255, 255, 255)\")",
    "expect(firstCardStyle[\"box-shadow\"]).not.toBe(\"none\")",
    "expect.poll(async () => ( await computedStyle(cards.nth(0), [\"background-color\"]) )[\"background-color\"]).not.toBe(firstCardStyle[\"background-color\"])",
    "expect(cards.nth(0).getByTestId(\"skill-card-avatar\")).toHaveCSS(\"font-size\", \"14px\")",
    "expect(installAction).toHaveCSS(\"width\", \"28px\")",
    "expect(installAction).toHaveCSS(\"height\", \"28px\")",
    "expect(installAction.getByTestId(\"skill-card-install-icon\")).toHaveAttribute(\"width\", \"16\")",
    "expect(actionStyle[\"background-color\"]).not.toBe(\"rgba(0, 0, 0, 0)\")",
    "expect(actionStyle[\"border-radius\"]).toBe(\"8px\")",
    "expect(page.getByRole(\"tooltip\")).toHaveCount(0)",
    "expect(topTooltip).toHaveText(longDescription)",
    "expect(topTooltip).toHaveAttribute(\"data-side\", \"bottom\")",
    "expect(topTooltip).toHaveCount(0)",
    "expect(bottomTooltip).toHaveText(longDescription)",
    "expect(bottomTooltip).toHaveAttribute(\"data-side\", \"top\")",
    "expect(page.getByRole(\"heading\", { name: \"web-tools-guide\", level: 1 })).toBeVisible()",
    "expect(page.getByTestId(\"skill-detail-stats\")).toHaveText(catalogStats)",
    "expect(page.getByRole(\"tablist\", { name: \"专家中心内容\" })).toHaveCount(0)",
    "expect(page.getByTestId(\"skill-detail-summary\")).toContainText(\"MANDATORY before calling\")",
    "expect(page.getByTestId(\"skill-detail-metadata\")).toContainText(\"knowledge-management\")",
    "expect(page.getByTestId(\"skill-detail-preview\")).not.toContainText(\"baseDir =\")",
    "expect(content.x - detail.x).toBeGreaterThanOrEqual(18)",
    "expect(content.x - detail.x).toBeLessThanOrEqual(22)",
    "expect(detail.right - content.right).toBeGreaterThanOrEqual(18)",
    "expect(detail.right - content.right).toBeLessThanOrEqual(22)",
    "expect(Math.abs(content.width - (detail.width - 40))).toBeLessThanOrEqual(1)",
    "expect(content.width).toBeGreaterThan(1100)",
    "expect( page.getByRole(\"status\").filter({ hasText: \"「web-tools-guide」技能已安装，去试试\" }), ).toContainText(\"「web-tools-guide」技能已安装，去试试\")",
    "expect(page.getByTestId(\"skill-detail-preview\")).toContainText(\"DETAIL_LINE_80\")",
    "expect(page.getByTestId(\"skill-detail-preview\")).not.toContainText(\"baseDir =\")",
    "expect.poll(() => detailScroll.evaluate((element) => element.scrollTop)).toBeGreaterThan(0)",
    "expect(Math.abs(headerAfterScroll.y - headerBeforeScroll.y)).toBeLessThanOrEqual(1)",
    "expect(page.getByTestId(\"skill-detail-source\")).toContainText(\"baseDir = /root/.openclaw/workspace/skills/web-tools-guide\")",
    "expect(page.getByRole(\"tablist\", { name: \"专家中心内容\" })).toBeVisible()"
