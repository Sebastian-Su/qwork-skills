    "expect(readLines(providerBrowserSink)).resolves.toEqual([])",
    "expect(readLines(providerInstallSink)).resolves.toEqual([])",
    "expect( fs.readFile(state, \"utf8\").then(JSON.parse), ).resolves.toMatchObject({ versionChecks: [\"dws\", \"zsxq-cli\", \"lovrabet\", \"tcb\"], dingtalk: true, zsxq: true, lovrabet: true, lovrabetPolls: 2, dingtalkStateDir: path.join( configHome, \"qwork\", \"connectors\", \"cli-data\", \"dingtalk\", ), zsxqStateDir: path.join( configHome, \"qwork\", \"connectors\", \"cli-data\", \"zsxq\", ), })",
    "expect( launched.page.getByRole(\"button\", { name: `${name}，已连接`, exact: true, }), ).toBeVisible({ timeout: 8_000 })",
    "expect .poll( async () => { const current = await readLines(providerStatusSink); return [\"dws\", \"zsxq-cli\", \"lovrabet\", \"tcb\"].every( (cli) => current.filter((entry) => entry === cli).length >= statusCountsBeforeRestart.filter((entry) => entry === cli) .length + 2, ); }, { timeout: 30_000 }, ) .toBe(true)",
    "expect(readLines(qworkAuthSink)).resolves.toEqual([ expect.stringMatching(/^https:\\/\\/login\\.dingtalk\\.com\\//), \"https://garden.zsxq.com/jasmine/index.html?code=FRESH-1234\", \"https://user.lovrabet.com/device-auth?code=LOVRABET-1234&source=lovrabet-cli\", \"https://tcb.cloud.tencent.com/login?ticket=QWORK-CLOUDBASE\", ])",
    "expect(readLines(providerBrowserSink)).resolves.toEqual([])",
    "expect( launched.page.getByRole(\"button\", { name: `${name}，未连接`, exact: true, }), ).toBeVisible()",
    "expect .poll(() => fs.access(path.join(privateDingtalkState, \"connected\")).then( () => true, () => false, ), ) .toBe(false)",
    "expect .poll(() => fs.access(path.join(privateZsxqState, \"connected\")).then( () => true, () => false, ), ) .toBe(false)",
    "expect .poll(() => fs.access(path.join(privateZsxqState, \"device_auth_pending.json\")).then( () => true, () => false, ), ) .toBe(false)",
    "expect .poll(() => fs.access(lovrabetPending).then( () => true, () => false, ), ) .toBe(false)",
    "expect( fs.readFile(path.join(sharedDingtalkState, \"keep\"), \"utf8\"), ).resolves.toBe(\"outside-qwork\")",
    "expect( fs.readFile(path.join(sharedZsxqState, \"keep\"), \"utf8\"), ).resolves.toBe(\"outside-qwork\")",
    "expect(finalProviderState).toMatchObject({ dingtalk: false, zsxq: false, lovrabet: false, providerLogoutCalls: [\"dws-logout\", \"zsxq-logout\", \"lovrabet-logout\"], })",
    "expect(finalProviderState.zsxqResumedDuringStatus).not.toBe(true)"
