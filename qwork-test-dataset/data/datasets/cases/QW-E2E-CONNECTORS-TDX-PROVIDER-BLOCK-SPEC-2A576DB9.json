  "expected_outcomes": [
    "expect.poll(async () => readLines(authUrlSink)).toHaveLength(1)",
    "expect(authorizeLines).toHaveLength(1)",
    "expect(authorize.origin).toBe(authorizationServer.origin)",
    "expect(authorize.pathname).toBe(\"/tdx-oauth/page_workbuddy_oauth.html\")",
    "expect(authorize.searchParams.get(\"response_type\")).toBe(\"code\")",
    "expect(authorize.searchParams.get(\"client_id\")).toBe( \"qwork-tdx-e2e-client\", )",
    "expect(authorize.searchParams.get(\"resource\")).toBe(oauth.resource)",
    "expect(authorize.searchParams.get(\"scope\")).toBe(oauth.scopes.join(\" \"))",
    "expect(authorize.searchParams.get(\"code_challenge_method\")).toBe(\"S256\")",
    "expect(authorize.searchParams.get(\"code_challenge\")).toMatch( /^[A-Za-z0-9_-]{43}$/, )",
    "expect(authorize.searchParams.get(\"state\")).toBeTruthy()",
    "expect(redirectUri).toMatch( /^http:\\/\\/127\\.0\\.0\\.1:\\d+\\/qconnector\\/tdx-connector\\/oauth\\/callback$/, )",
    "expect(new URL(redirectUri!).protocol).toBe(\"http:\")",
    "expect(authorizationServer.registrationRequests).toHaveLength(1)",
    "expect(authorizationServer.registrationRequests[0]).toMatchObject({ redirect_uris: [redirectUri], token_endpoint_auth_method: \"none\", application_type: \"native\", })"
