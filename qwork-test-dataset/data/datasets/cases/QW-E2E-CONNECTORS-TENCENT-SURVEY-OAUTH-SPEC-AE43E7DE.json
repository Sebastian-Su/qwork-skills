  "expected_outcomes": [
    "expect.poll(async () => readLines(authUrlSink)).toHaveLength(1)",
    "expect(authorize.origin).toBe(provider.origin)",
    "expect(authorize.pathname).toBe(\"/api/v2/mcp/oauth/authorize\")",
    "expect(authorize.searchParams.get(\"client_id\")).toBe(FRESH_CLIENT_ID)",
    "expect(authorize.searchParams.get(\"client_id\")).not.toBe(STALE_CLIENT_ID)",
    "expect(authorize.searchParams.get(\"scope\")).toBe( shipped.scopes?.join(\" \") ?? null, )",
    "expect(authorize.searchParams.get(\"resource\")).toBe(resource)",
    "expect(authorize.searchParams.get(\"code_challenge_method\")).toBe(\"S256\")",
    "expect(authorize.searchParams.get(\"code_challenge\")).toBeTruthy()",
    "expect(redirect).toMatch( /^http:\\/\\/127\\.0\\.0\\.1:\\d+\\/qconnector\\/tencent-survey\\/oauth\\/callback$/, )",
    "expect(state).toBeTruthy()",
    "expect(provider.registrationRequests).toHaveLength(1)",
    "expect(provider.registrationRequests[0]).toMatchObject({ redirect_uris: [redirect], grant_types: [\"authorization_code\"], response_types: [\"code\"], token_endpoint_auth_method: \"none\", application_type: \"native\", })",
    "expect(provider.registrationRequests[0].client_name).toMatch( /^qwork-tencent-survey-/, )",
    "expect(callback.status).toBe(200)",
    "expect.poll(() => provider.tokenRequests).toHaveLength(1)",
    "expect(provider.tokenRequests[0].get(\"grant_type\")).toBe( \"authorization_code\", )",
    "expect(provider.tokenRequests[0].get(\"client_id\")).toBe(FRESH_CLIENT_ID)",
    "expect(provider.tokenRequests[0].get(\"redirect_uri\")).toBe(redirect)",
    "expect(provider.tokenRequests[0].get(\"resource\")).toBe(resource)",
    "expect(verifier).toBeTruthy()",
    "expect(createHash(\"sha256\").update(verifier!).digest(\"base64url\")).toBe( authorize.searchParams.get(\"code_challenge\"), )",
    "expect( detail.getByRole(\"button\", { name: \"停用\", exact: true }), ).toBeVisible()",
    "expect .poll(async () => (await readMcpLog(mcpLog)).find( (entry) => entry.type === \"mcp_server_upsert\" && (entry.server as { name?: string } | undefined)?.name === CONNECTOR_ID, ), ) .toBeTruthy()",
    "expect(event?.server).toEqual( expect.objectContaining({ name: CONNECTOR_ID, transport: \"http\", url: resource, static_headers: { Authorization: `Bearer ${ACCESS_TOKEN}` }, }), )",
    "expect(event?.server).not.toHaveProperty(\"oauth\")",
    "expect(await readLines(authUrlSink)).toHaveLength(1)"
  ],
