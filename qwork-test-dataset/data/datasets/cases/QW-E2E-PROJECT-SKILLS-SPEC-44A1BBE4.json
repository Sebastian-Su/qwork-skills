  "expected_outcomes": [
    "expect(skillCard).toContainText(\"技能\")",
    "expect(managerBox.width).toBeCloseTo(800, 0)",
    "expect(managerBox.height).toBeCloseTo(560, 0)",
    "expect(managerStyle[\"border-radius\"]).toBe(\"24px\")",
    "expect(compactManagerBox.width).toBeCloseTo(652, 0)",
    "expect(compactManagerBox.height).toBeCloseTo(452, 0)",
    "expect((await boxOf(addMenu)).width).toBeCloseTo(162, 0)",
    "expect(manager).toContainText(\"project-local-helper\")",
    "expect(skillCard).toContainText(\"技能 1\")",
    "expect(picker.getByRole(\"tab\", { name: \"推荐\" })).toHaveCount(0)",
    "expect(picker.getByRole(\"tab\", { name: \"SkillHub\" })).toBeVisible()",
    "expect(picker.getByRole(\"tab\", { name: \"已安装\" })).toBeVisible()",
    "expect(picker.getByRole(\"button\", { name: \"SkillHub 来源\" })).toContainText(\"360 SkillHub\")",
    "expect(picker.getByRole(\"checkbox\", { name: \"选择Weather\" })).toBeVisible()",
    "expect(picker.getByRole(\"checkbox\", { name: \"选择目录技能 199\" })).toBeVisible()",
    "expect(manager).toContainText(\"Weather\")",
    "expect(skillCard).toContainText(\"技能 2\")",
    "expect.poll(async () => page.evaluate(async () => (await window.workGui!.skillHub.installed()).length, )).toBe(personalBefore)",
    "expect(projectSkillPaths).toHaveLength(2)",
    "expect(projectSkillPaths.every((installDir) => installDir.includes(`${path.sep}.ziqdo${path.sep}skills${path.sep}`))).toBe(true)",
    "expect(projectSkillPaths.every((installDir) => !installDir.startsWith(path.join(configHome, \"skills\")))).toBe(true)",
    "expect(catalogEvidence.global.filter((skill) => skill.id === \"Weather\")).toEqual([ expect.objectContaining({ name: \"Weather\", source: \"skillhub\" }), ])",
    "expect(catalogEvidence.global.some((skill) => skill.id === \"project-local-helper\")).toBe(false)",
    "expect(catalogEvidence.global.some((skill) => skill.id === \"目录技能 1\")).toBe(false)",
    "expect(catalogEvidence.scoped.map((skill) => skill.id)).toContain(\"project-local-helper\")",
    "expect(catalogEvidence.scoped.filter((skill) => skill.id === \"Weather\")).toEqual([ expect.objectContaining({ name: \"Weather\", source: \"project\" }), ])",
    "expect(catalogEvidence.scoped).toEqual(expect.arrayContaining([ expect.objectContaining({ id: \"project-local-helper\", source: \"project\" }), ]))",
    "expect(catalogEvidence.scoped.some((skill) => skill.id === \"目录技能 1\")).toBe(false)",
    "expect(slashPicker.getByRole(\"option\", { name: /Personal Weather version/ })).toHaveCount(1)",
    "expect(slashPicker.getByRole(\"option\", { name: /project-local-helper/ })).toHaveCount(0)",
    "expect(slashPicker.getByRole(\"option\", { name: /目录技能 1/ })).toHaveCount(0)",
    "expect(slashPicker.getByRole(\"option\", { name: /Weather description/ })).toHaveCount(1)",
    "expect(slashPicker.getByRole(\"option\", { name: /Personal Weather version/ })).toHaveCount(0)",
    "expect(slashPicker.getByRole(\"option\", { name: /project-local-helper/ })).toHaveCount(1)",
    "expect(slashPicker.getByRole(\"option\", { name: /目录技能 1/ })).toHaveCount(0)",
    "expect.poll(() => selectedSkillsFromLog(sidecarLog)).toEqual(expectedSelectedSkills)",
    "expect(new Set(await selectedSkillsFromLog(sidecarLog)).size).toBe(expectedSelectedSkills.length)",
    "expect(picker.getByRole(\"checkbox\", { name: \"选择prompt-doctor\" })).toBeVisible()",
    "expect(picker.getByRole(\"checkbox\", { name: \"选择Weather\" })).toBeVisible()",
    "expect(locked).toBeChecked()",
    "expect(locked).toBeDisabled()",
    "expect(picker.getByText(\"请在管理页移除\").first()).toBeVisible()",
    "expect(picker).toBeHidden()",
    "expect(manager).toBeVisible()",
    "expect(confirmation).toContainText(\"移除后项目内任务将不再使用该技能\")",
    "expect(manager).not.toContainText(\"Weather\")",
    "expect(persisted).toEqual([\"project-local-helper\"])",
    "expect((await page.evaluate(() => window.workGui!.skillHub.installed())).map((item) => item.runtimeSkillId)).toContain(\"Weather\")",
    "expect(page.getByRole(\"button\", { name: \"管理技能\" })).toContainText(\"技能 1\")"
  ],
