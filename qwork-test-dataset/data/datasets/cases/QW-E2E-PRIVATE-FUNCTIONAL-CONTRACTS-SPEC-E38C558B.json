    "expect(interrupted).toBeVisible()",
    "expect(runs).toHaveLength(2)",
    "expect(oldRun?.status).toBe(\"interrupted\")",
    "expect(newRun).toMatchObject({ memberId: oldRun?.memberId, status: \"completed\", retryOf: \"team-release-retry\", text: \"发布准备重试完成\", })",
