  "expected_outcomes": [
    "expect(page.getByText(\"文件已生成\", { exact: true })).toBeVisible()",
    "expect(firstCard).toBeVisible()",
    "expect(firstCard.getByTestId(\"artifact-file-size\")).toContainText(/KB|B/)",
    "expect(firstCard.getByTestId(\"artifact-open-arrow\")).toBeVisible()",
    "expect(secondCard).toBeVisible()",
    "expect(allButton).toBeVisible()",
    "expect(page.getByRole(\"button\", { name: /打开产出物 方案汇报\\.pptx/ })).not.toBeVisible()",
    "expect(firstBox).not.toBeNull()",
    "expect(secondBox).not.toBeNull()",
    "expect(Math.abs(firstBox!.y - secondBox!.y)).toBeLessThanOrEqual(2)",
    "expect(secondBox!.x).toBeGreaterThan(firstBox!.x)",
    "expect(page.getByRole(\"status\", { name: \"文件预览通知\" })).toHaveText( \"文件已在预览面板打开\", )",
    "expect(composer).toBeFocused()",
    "expect .poll(() => firstCard.evaluate( (element) => getComputedStyle(element).backgroundColor, ), ) .not.toBe(defaultBackground)",
    "expect(page.getByRole(\"button\", { name: /打开产出物 方案汇报\\.pptx/ })).toBeVisible()",
    "expect(firstCard).toBeFocused()",
    "expect(page.getByTestId(\"office-compact-shell\")).toBeVisible()",
    "expect(editorReady).toBeVisible({ timeout: 60_000 })",
    "expect(toolbar).toBeVisible()",
    "expect(toolbar.getByRole(\"button\").first()).toBeVisible()",
    "expect( panel.getByRole(\"button\", { name: \"Show document outline\", exact: true, }), ).toHaveCount(0)",
    "expect( panel.getByLabel(\"Horizontal ruler\", { exact: true }), ).toHaveCount(0)",
    "expect( panel.getByLabel(\"Vertical ruler\", { exact: true }), ).toHaveCount(0)",
    "expect( panel.getByText(name, { exact: true }), ).toHaveCount(1)",
    "expect( page.getByText(\"Loading document...\", { exact: true }), ).toBeHidden()",
    "expect( page.getByText(/Couldn't open this workbook|No slides/), ).toHaveCount(0)",
    "expect( await page.evaluate( () => document.documentElement.scrollWidth <= document.documentElement.clientWidth + 2, ), ).toBe(true)",
    "expect .poll(async () => { const after = await docxFitGeometry(page); return Math.abs(after.pageWidth - beforeZoomOut.pageWidth); }) .toBeLessThanOrEqual(2)",
    "expect(page.getByTestId(\"office-artifact-card-group\")).toBeVisible()"
  ],
