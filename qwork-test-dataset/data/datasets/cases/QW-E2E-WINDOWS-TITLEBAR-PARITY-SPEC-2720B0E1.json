  "expected_outcomes": [
    "expect(page.getByTestId(\"global-qwork-logo\")).toHaveAttribute( \"src\", /icon-qwork-mascot-dock-frame-v5/, )",
    "expect(page.getByRole(\"menu\", { name: \"QWork\" }).getByRole(\"menuitem\")).toHaveText([ \"关于 QWork\", \"检查更新...\", \"退出 QWorkAlt+F4\", ])",
    "expect(page.getByRole(\"menuitem\", { name: \"退出 QWork Alt+F4\" })).toBeFocused()",
    "expect(page.getByRole(\"menuitem\", { name: \"关于 QWork\" })).not.toBeFocused()",
    "expect(page.getByRole(\"menu\", { name: \"编辑\" }).getByRole(\"menuitem\")).toHaveText([ \"撤销(U)Ctrl+Z\", \"重做(R)Ctrl+Y\", \"剪切(T)Ctrl+X\", \"复制(C)Ctrl+C\", \"粘贴(P)Ctrl+V\", \"全选(A)Ctrl+A\", ])",
    "expect(page.getByRole(\"menu\", { name: \"窗口\" }).getByRole(\"menuitem\")).toHaveText([ \"关闭窗口(C)Ctrl+W\", ])",
    "expect(page.getByRole(\"menu\", { name: \"帮助\" }).getByRole(\"menuitem\")).toHaveText([ \"使用文档\", \"诊断工具\", \"打开日志目录(L)\", \"意见反馈\", \"开放 API\", ])"
  ],
