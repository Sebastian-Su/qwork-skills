    "expect(row.getByLabel(\"未分配\")).toBeVisible()",
    "expect(row.getByTestId(\"plan-assignee-default-avatar\")).toBeVisible()",
    "expect(page.getByRole(\"listbox\", { name: \"优先级选项\" })).toBeVisible()",
    "expect(row.getByRole(\"button\", { name: \"编辑优先级\" })).toContainText(\"高\")",
    "expect(page.getByRole(\"listbox\", { name: \"选择处理人\" })).toBeVisible()",
    "expect(page.getByRole(\"listbox\", { name: \"状态选项\" })).toBeVisible()",
    "expect(row.getByRole(\"button\", { name: \"编辑处理人\" })).toHaveCount(0)",
    "expect(rowLabelOptions).toBeVisible()",
    "expect(row.getByTestId(\"plan-list-title-cell\")).toContainText(itemSecondLabel)",
    "expect(row.getByRole(\"button\", { name: /更多操作/ })).toHaveCount(0)",
    "expect(selectedToolbar).toContainText(\"1 个已选择\")",
    "expect(selectedToolbar).toHaveCount(0)",
    "expect(longTitleButton).toHaveText(visibleLongItemTitle)",
    "expect(longTitleButton).toHaveAttribute(\"title\", longItemTitle)",
    "expect(Array.from(await longTitleButton.textContent())).toHaveLength(40)",
    "expect(columnLefts[0]).toEqual(columnLefts[1])",
    "expect(rowGaps.statusToTitle).toBeLessThanOrEqual(4)",
    "expect(rowGaps.assigneeToTime).toBeLessThanOrEqual(4)",
    "expect(inProgressToggleWidth).toBeGreaterThan(300)",
    "expect(inProgress).toContainText(\"输入待办标题\")",
    "expect(card.getByRole(\"button\", { name: \"未分配\" })).toBeVisible()",
    "expect(card.getByTestId(\"plan-assignee-default-avatar\")).toBeVisible()",
    "expect(detail.getByLabel(\"待办标题，编辑后失焦保存\")).toHaveAttribute(\"maxlength\", \"200\")",
    "expect(priorityField.getByRole(\"button\", { name: \"编辑优先级\" })).toBeVisible()",
    "expect(priorityField.getByRole(\"button\", { name: \"编辑标签\" })).toBeVisible()",
    "expect(detail.getByTestId(\"todo-detail-field-标签\")).toHaveCount(0)"
