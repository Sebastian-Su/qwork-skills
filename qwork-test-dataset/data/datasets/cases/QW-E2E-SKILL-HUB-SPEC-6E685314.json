  "expected_outcomes": [
    "expect(composer).toHaveValue(\"请帮我编辑 `Weather` 这个 skill\")",
    "expect(page.getByTestId(\"composer-editor\").getByTestId(\"selected-skill-token\")) .toHaveText([\"skill-creator\", \"Weather\"])",
    "expect.poll(() => createSessionsFromLog(sidecarLog)).toHaveLength(0)",
    "expect(intentId).toMatch(/^[0-9a-f-]{36}$/i)",
    "expect(page.getByRole(\"textbox\")).toHaveValue(\"请帮我编辑 `Weather` 这个 skill\")",
    "expect(page.getByTestId(\"composer-editor\").getByTestId(\"selected-skill-token\")) .toHaveText([\"skill-creator\", \"Weather\"])",
    "expect(fs.readFile(path.join(activeSkillRoot, \"SKILL.md\"), \"utf8\")) .resolves.toBe(activeBeforeSend)",
    "expect.poll(() => createSessionsFromLog(sidecarLog)).toHaveLength(1)",
    "expect(editSession.selected_skills).toEqual([\"skill-creator\", \"Weather\"])",
    "expect(editSession.additional_roots).toEqual([workspaceRoot])",
    "expect(editSession.plugin_dirs).toHaveLength(1)",
    "expect(editSession.host_instructions).toEqual(expect.arrayContaining([ expect.stringContaining(\"editing the QWork-managed Skill\"), expect.stringContaining(\"Call qwork_skill_edit with action=status\"), ]))",
    "expect.poll(async () => { const intent = JSON.parse( await fs.readFile(path.join(intentRoot, \"intent.json\"), \"utf8\"), ) as { state?: string; sessionId?: string }; return { state: intent.state, sessionId: intent.sessionId }; }).toEqual({ state: \"bound\", sessionId: editSession.session_id })",
    "expect(initialStatus).toMatchObject({ runtimeSkillId: \"Weather\", workspaceRoot, hasChanges: false, })",
    "expect(await fs.readFile(path.join(activeSkillRoot, \"SKILL.md\"), \"utf8\")) .toBe(activeBeforeSend)",
    "expect(callSkillEditTool(pluginRoot, \"validate\")).resolves.toMatchObject({ valid: true, runtimeSkillId: \"Weather\", hasChanges: true, })",
    "expect(callSkillEditTool(pluginRoot, \"commit\")).resolves.toMatchObject({ committed: true, effectiveIn: \"new-session\", })",
    "expect(fs.readFile(path.join(activeSkillRoot, \"SKILL.md\"), \"utf8\")) .resolves.toContain(marker)",
    "expect.poll(async () => { const metadata = JSON.parse( await fs.readFile(path.join(activeSkillRoot, \"_qwork_skillhub_meta.json\"), \"utf8\"), ) as { modificationState?: string }; return metadata.modificationState; }).toBe(\"modified\")",
    "expect( page.getByTestId(\"composer-editor\").getByTestId(\"selected-skill-token\"), ).toHaveText([\"Weather\"])",
    "expect(page.getByRole(\"textbox\")).toHaveValue(\"\")",
    "expect(page.getByRole(\"textbox\")).toHaveValue( \"__E2E_VERIFY_SKILL_CONTENT__:Weather\", )",
    "expect(page.getByRole(\"button\", { name: \"发送\", exact: true })).toBeEnabled()",
    "expect.poll(() => createSessionsFromLog(sidecarLog)).toHaveLength(2)",
    "expect(page.getByText(marker, { exact: true })).toBeVisible()"
  ],
