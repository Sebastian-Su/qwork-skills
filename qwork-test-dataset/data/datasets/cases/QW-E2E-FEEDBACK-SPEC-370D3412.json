  "expected_outcomes": [
    "expect(turns).toHaveCount(1)",
    "expect(likeTurn).toContainText(\"收到：验证点赞反馈链路\")",
    "expect(like).toHaveAttribute(\"aria-pressed\", \"true\")",
    "expect.poll(() => feedbackSls.records.find((record) => ( record.event_name === \"ui.feedback.action\" && record.feedback_source === \"assistant_message\" && record.feedback_action === \"like\" ))).toMatchObject({ attr: \"点赞\" })",
    "expect(like).toBeEnabled()",
    "expect(like).toHaveAttribute(\"aria-pressed\", \"false\")",
    "expect.poll(() => feedbackSls.records.find((record) => ( record.event_name === \"ui.feedback.action\" && record.feedback_source === \"assistant_message\" && record.feedback_action === \"cancel\" ))).toMatchObject({ attr: \"取消反馈\" })",
    "expect(turns).toHaveCount(2)",
    "expect(turn).toContainText(\"收到：验证踩和更多反馈链路\")",
    "expect(reasons).toBeVisible()",
    "expect(reasons).toHaveAttribute(\"data-placement\", \"bottom\")",
    "expect(reasons.getByRole(\"checkbox\")).toHaveCount(7)",
    "expect(turn.getByRole(\"status\")).toHaveText(\"感谢反馈\")",
    "expect.poll(() => feedbackSls.records.find((record) => ( record.event_name === \"ui.feedback.action\" && record.feedback_action === \"dislike\" ))).toMatchObject({ feedback_source: \"assistant_message\", attr: \"回答不清晰,其他\", feedback_has_custom_text: \"true\", feedback_custom_text_length_bucket: \"1_50\", })",
    "expect(JSON.stringify(feedbackSls.records)).not.toContain(privateReason)",
    "expect(full).toBeVisible()",
    "expect(full).not.toBeVisible()",
    "expect(page.getByTestId(\"feedback-success-toast\")).toContainText( \"反馈提交成功，感谢您的反馈！\", )",
    "expect.poll(() => feedbackSls.records.find((record) => ( record.event_name === \"ui.feedback.action\" && record.feedback_source === \"assistant_more\" ))).toMatchObject({ feedback_action: \"submit\", attr: \"自定义反馈\", feedback_content_length_bucket: \"1_200\", })",
    "expect(JSON.stringify(feedbackSls.records)).not.toContain(privateContent)",
    "expect(JSON.stringify(feedbackRecords(feedbackSls.records))).not.toMatch( /\"(?:mid|qid|user_id)\":/, )"
  ],
