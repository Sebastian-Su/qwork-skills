  "expected_outcomes": [
    "expect .poll(() => page.evaluate(() => window.workGui.auth.status().then((status) => status.loggedIn), ), ) .toBe(true)",
    "expect(page.getByRole(\"link\", { name: \"QWork 官方网站\" })).toHaveAttribute( \"href\", \"https://qwork.360.cn/\", )",
    "expect(page.getByText(\"WebSearch\", { exact: true })).toHaveCount(0)",
    "expect(page.getByRole(\"button\", { name: \"引用 1 篇资料作为参考\" })).toBeVisible()",
    "expect(sources).toBeVisible()",
    "expect(sources.getByText(\"回答已引用\")).toHaveCount(0)",
    "expect(sources.getByText(\"由 QWork 联网搜索提供\")).toHaveCount(0)",
    "expect(sources.locator('[data-site-favicon=\"qwork.360.cn\"][data-favicon-url]')).toHaveAttribute( \"data-favicon-url\", \"https://cdn-yb.icon.qq.com/zuowei_dir/qwork_360_cn.ico\", )",
    "expect(sources).toHaveCSS(\"overflow-x\", \"hidden\")",
    "expect(sources).toBeVisible()",
    "expect(sources).toHaveCount(0)",
    "expect( controls .filter((message) => message.type === \"create_session\") .map((message) => message.qwork_api), ).toContainEqual({ base_url: server.baseUrl, access_token: \"[REDACTED]\", scopes: [\"media.generate\", \"search.query\"], })",
    "expect(controls).toContainEqual({ type: \"e2e_qwork_search_completed\", result_count: 1, })"
  ],
