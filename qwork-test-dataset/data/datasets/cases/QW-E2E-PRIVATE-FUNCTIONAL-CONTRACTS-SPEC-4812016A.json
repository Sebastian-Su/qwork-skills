  "expected_outcomes": [
    "expect(button).toBeVisible()",
    "expect(Object.fromEntries(terminalByThread)).toEqual({ \"terminal-completed\": \"completed\", \"terminal-failed\": \"failed\", \"terminal-blocked\": \"blocked\", \"terminal-interrupted\": \"interrupted\", })",
    "expect(page.getByRole(\"heading\", { name: \"失败成员\" })).toBeVisible()",
    "expect(page.locator(\"article\").getByText(\"失败\", { exact: true })).toBeVisible()",
    "expect(page.getByRole(\"button\", { name: \"重试此成员任务\" })).toBeVisible()",
    "expect(page.getByRole(\"heading\", { name: \"阻塞成员\" })).toBeVisible()",
    "expect(page.locator(\"article\").getByText(\"待确认\", { exact: true })).toBeVisible()",
    "expect(page.getByRole(\"heading\", { name: \"中断成员\" })).toBeVisible()",
    "expect(page.locator(\"article\").getByText(\"已中断\", { exact: true })).toBeVisible()",
    "expect(page.getByRole(\"button\", { name: \"重试此成员任务\" })).toBeVisible()"
  ],
