    "uiExpect.soft(page.getByRole(\"button\", { name: \"添加技能\", exact: true })).toBeVisible()",
    "uiExpect.soft(page.getByRole(\"tab\", { name: \"技能\", exact: true })).toHaveAttribute(\"aria-selected\", \"true\")",
    "expect((await boxOf(skillHub)).x - (await boxOf(recommended)).right).toBeCloseTo(20, 1)",
    "expect(activeStyle).toEqual({ \"background-color\": \"rgba(0, 0, 0, 0)\", \"border-bottom-width\": \"0px\", \"border-radius\": \"0px\", color: \"rgb(0, 0, 0)\", \"font-family\": \"Arial\", \"font-size\": \"20px\", \"font-weight\": \"600\", \"line-height\": \"28px\", \"padding-bottom\": \"4px\", })",
    "expect(await computedStyle(skillHub, [\"color\", \"font-weight\"])).toEqual({ color: \"rgba(0, 0, 0, 0.5)\", \"font-weight\": \"400\", })",
    "expect.poll(async () => (await computedStyle(skillHub, [\"color\"])).color).toBe(\"rgba(0, 0, 0, 0.7)\")",
    "uiExpect.soft(page.getByPlaceholder(/搜索技能/)).toBeVisible()",
    "uiExpect.soft(page.getByRole(\"button\", { name: /我安装的 \\(\\d+\\)/ })).toBeVisible()",
    "expect(await computedStyle(dragSurface, [\"-webkit-app-region\"])) .toEqual({ \"-webkit-app-region\": \"drag\" })",
    "expect(toolbar).toHaveAttribute(\"data-main-content-toolbar\", \"true\")",
    "expect(toolbarBox.y).toBeGreaterThanOrEqual(chromeBox.bottom)",
    "expect(toolbarBox.x).toBeCloseTo(mainBox.x, 0)",
    "expect(toolbarBox.width).toBeCloseTo(mainBox.width, 0)",
    "expect(toolbar).toHaveAttribute(\"data-tauri-drag-region\")",
    "expect(toolbar).not.toHaveAttribute(\"data-no-drag\")",
    "expect(await computedStyle(toolbar, [\"-webkit-app-region\"])) .toEqual({ \"-webkit-app-region\": \"drag\" })"
