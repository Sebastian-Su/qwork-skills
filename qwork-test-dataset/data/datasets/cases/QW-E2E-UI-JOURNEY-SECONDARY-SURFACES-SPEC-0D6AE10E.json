  "expected_outcomes": [
    "uiExpect.soft(page.getByText(\"暂无可用推荐技能\", { exact: true })).toBeVisible()",
    "uiExpect.soft(page.getByRole(\"tab\", { name: tab, exact: true })).toBeVisible()",
