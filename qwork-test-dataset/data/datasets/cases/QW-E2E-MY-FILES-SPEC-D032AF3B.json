  "expected_outcomes": [
    "expect(page.getByText(/收到：.*E2E_ARTIFACT.*任务产出/)).toBeVisible()",
    "expect .poll(() => fs.readFile(path.join(workspace, \"任务产出.md\"), \"utf8\")) .toContain(\"E2E workspace file\")",
    "expect( (await fs.readdir(workspace, { withFileTypes: true })).filter((entry) => entry.isDirectory(), ), ).toEqual([])",
    "expect(page.getByRole(\"heading\", { name: \"本地助理\" })).toBeVisible()",
    "expect(page.getByText(/收到：.*E2E_ARTIFACT.*助理产出/)).toBeVisible()",
    "expect(assistantDirectories).toHaveLength(1)",
    "expect(assistantDirectory.name).toMatch( /^\\d{4}-\\d{2}-\\d{2}-\\d{2}-\\d{2}-\\d{2}(?:-\\d+)?$/, )",
    "expect( fs.readFile( path.join(workspace, assistantDirectory.name, \"助理产出.md\"), \"utf8\", ), ).resolves.toContain(\"E2E workspace file\")",
    "expect .poll(() => page.evaluate(() => window.workGui.files.list())) .toHaveLength(2)",
    "expect(page.getByRole(\"heading\", { name: \"我的文件\" })).toBeVisible()",
    "expect(page.getByText(\"任务产出.md\", { exact: true })).toBeVisible()",
    "expect(page.getByText(\"助理产出.md\", { exact: true })).toBeVisible()",
    "expect( page.locator(\"header\").getByRole(\"button\", { name: \"助理\", exact: true }), ).toHaveCount(0)",
    "expect(page.getByRole(\"status\", { name: \"云端同步说明\" })).toContainText( \"任务成果仍安全保存在本地\", )",
    "expect( taskOutputRow.getByRole(\"button\", { name: \"云端网盘尚未配置\", }), ).toBeDisabled()",
    "expect(shareDialog).toBeVisible()",
    "expect( shareDialog.getByText(\"任务产出.md\", { exact: true }), ).toBeVisible()",
    "expect( shareDialog.getByRole(\"button\", { name: \"复制链接\" }), ).toBeVisible()",
    "expect( shareDialog.getByRole(\"button\", { name: \"生成二维码\" }), ).toBeVisible()",
    "expect( shareDialog.getByRole(\"button\", { name: \"浏览器打开\" }), ).toBeVisible()",
    "expect(Math.abs(geometry.width - 452)).toBeLessThanOrEqual(2)",
    "expect( Math.abs(geometry.x + geometry.width / 2 - geometry.viewportWidth / 2), ).toBeLessThanOrEqual(2)",
    "expect( Math.abs(geometry.y + geometry.height / 2 - geometry.viewportHeight / 2), ).toBeLessThanOrEqual(2)",
    "expect(geometry.borderRadius).toBe(\"24px\")"
  ],
