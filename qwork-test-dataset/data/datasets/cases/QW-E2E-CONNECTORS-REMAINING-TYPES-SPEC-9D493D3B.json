    "expect(page.getByText(\"收到：查看我今天的会议\", { exact: true })).toBeVisible()",
    "expect.poll(async () => { const records = await fs.readFile(controlLog, \"utf8\").catch(() => \"\"); return records .split(\"\\n\") .filter(Boolean) .map((line) => JSON.parse(line) as { type?: string; content?: unknown }) .find((record) => record.type === \"user_message\"); }).toMatchObject({ type: \"user_message\" })",
    "expect(promptWire).toContain(\"CLI 连接器：tmeet\")",
    "expect(promptWire).toContain(\"tencent-meeting-skill\")",
    "expect(promptWire).not.toContain(\"MCP 连接器：tmeet\")",
    "expect(page.getByRole(\"button\", { name: \"腾讯会议，未连接\" })).toBeVisible()",
    "expect.poll(async () => fs.access(loggedIn).then(() => true, () => false)).toBe(false)",
    "expect.poll(async () => { const records = (await fs.readFile(controlLog, \"utf8\").catch(() => \"\")) .split(\"\\n\") .filter(Boolean) .map((line) => JSON.parse(line) as { type?: string; skills?: string[] }) .filter((record) => record.type === \"set_skills\"); return records.length > setSkillsBeforeUnbind && Array.isArray(records.at(-1)?.skills) && !records.at(-1)!.skills!.includes(\"tencent-meeting-skill\"); }).toBe(true)"
