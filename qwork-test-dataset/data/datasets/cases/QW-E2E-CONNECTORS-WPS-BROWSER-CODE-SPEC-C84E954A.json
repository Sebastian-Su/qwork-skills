    "expect(page.getByRole(\"button\", { name: \"金山文档，已连接\" })).toBeVisible()",
    "expect(page.getByRole(\"button\", { name: \"WPS知识库，已连接\" })).toBeVisible()",
    "expect(page.getByRole(\"button\", { name: \"金山文档，已连接\" })).toBeVisible({ timeout: 4_000, })",
    "expect(page.getByRole(\"button\", { name: \"WPS知识库，已连接\" })).toBeVisible({ timeout: 4_000, })",
    "expect(await readLines(authUrlSink)).toHaveLength(1)",
    "expect(exchange!.requests).toHaveLength(2)",
    "expect(page.getByRole(\"button\", { name: \"金山文档，未连接\" })).toBeVisible({ timeout: 20_000, })",
    "expect(page.getByRole(\"button\", { name: \"WPS知识库，未连接\" })).toBeVisible({ timeout: 20_000, })",
    "expect(await readVaultRecordKeys(configHome)).toEqual([])",
    "expect(new Set(firstRemovalNames)).toEqual( new Set([\"kdocs\", \"wps-knowledgebase\"]), )",
    "expect.poll(async () => (await readLines(authUrlSink)).length).toBe(2)",
    "expect(secondCode).not.toBe(firstCode)",
    "expect.poll(() => exchange!.requests.length, { timeout: 10_000 }).toBe(4)",
    "expect(detail.getByRole(\"button\", { name: \"停用\", exact: true })).toBeVisible({ timeout: 15_000, })",
    "expect(exchange!.requests.slice(2)).toEqual([ { code: secondCode, ordinalForCode: 1, method: \"POST\", contentType: \"application/json\", }, { code: secondCode, ordinalForCode: 2, method: \"POST\", contentType: \"application/json\", }, ])",
    "expect(await readVaultRecordKeys(configHome)).toHaveLength(1)",
    "expect(page.getByRole(\"button\", { name: \"金山文档，未连接\" })).toBeVisible()",
    "expect(page.getByRole(\"button\", { name: \"WPS知识库，未连接\" })).toBeVisible()",
    "expect(await readVaultRecordKeys(configHome)).toEqual([])",
    "expect(upsertNames).toHaveLength(2)",
    "expect(new Set(upsertNames)).toEqual(new Set([\"kdocs\", \"wps-knowledgebase\"]))",
    "expect(secondRemovalNames).toEqual( expect.arrayContaining([\"kdocs\", \"wps-knowledgebase\"]), )",
    "expect(new Set(secondRemovalNames)).toEqual( new Set([\"kdocs\", \"wps-knowledgebase\"]), )",
    "expect(await readLines(authUrlSink)).toHaveLength(2)"
