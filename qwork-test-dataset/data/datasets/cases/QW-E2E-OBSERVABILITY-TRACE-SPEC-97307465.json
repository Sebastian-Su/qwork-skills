  "expected_outcomes": [
    "expect(page.getByText(\"可观测链路完成\", { exact: true })).toBeVisible()",
    "expect.poll( () => received.some((record) => record.event_name === \"turn.complete\"), { timeout: 15_000 }, ).toBe(true)",
    "expect( root, `received events: ${received.map((record) => `${record.schema_version}:${record.event_name ?? record.attr ?? \"unknown\"}`).join(\", \")}`, ).toBeDefined()",
    "expect(root!.trace_id).toMatch(/^[0-9a-f]{32}$/)",
    "expect(trace.map((record) => `${record.event_name}:${record.event_phase}`)).toEqual( expect.arrayContaining([ \"ui.prompt.submit:start\", \"ui.prompt.submit:accepted\", \"engine.turn.dispatch:start\", \"engine.turn.accept:accepted\", \"model.request:start\", \"provider.request.dispatch:start\", \"provider.response.headers:accepted\", \"provider.stream.first_chunk:first\", \"provider.stream.first_sse_event:first\", \"provider.connectio…",
    "expect(accepted?.duration_ms).toMatch(/^\\d+$/)",
    "expect(terminal).toMatchObject({ terminal_status: \"idle\", outcome: \"success\", })",
    "expect(terminal?.duration_ms).toMatch(/^\\d+$/)",
    "expect(terminal?.received_latency_ms).toMatch(/^\\d+$/)",
    "expect(new Set(trace.map((record) => record.session_id).filter(Boolean)).size).toBe(1)",
    "expect(trace.find((record) => record.event_name === \"provider.connection.terminated\")).toMatchObject({ disconnect_initiator: \"local\", disconnect_reason: \"local_timeout\", transport_phase: \"response_body\", transport_peer: \"local_gateway\", local_abort_intent: \"true\", terminal_marker_seen: \"false\", request_timeout_ms: \"600000\", read_idle_timeout_ms: \"300000\", })",
    "expect(JSON.stringify(trace)).not.toContain(\"__E2E_OBSERVABILITY_PRIVATE_PROMPT__\")",
    "expect(JSON.stringify(trace)).not.toContain(\"private tool output\")",
    "expect.poll(() => page.evaluate(() => window.workGui!.clipboard.readText())) .toBe(root!.trace_id)",
    "expect( restarted.page.getByTestId(\"assistant-message\").filter({ hasText: \"可观测链路完成\", }), ).toBeVisible()",
    "expect.poll( () => restarted.page.evaluate(() => window.workGui!.clipboard.readText()), ).toBe(root!.trace_id)"
  ],
