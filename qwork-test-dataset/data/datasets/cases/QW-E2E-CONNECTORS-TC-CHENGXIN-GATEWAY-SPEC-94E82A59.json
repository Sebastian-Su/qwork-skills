  "expected_outcomes": [
    "expect.poll(async () => readLines(authUrlSink)).toHaveLength(1)",
    "expect(authorize.origin).toBe(\"https://m.ly.com\")",
    "expect(authorize.pathname).toBe(\"/memberauth/oauth2/authorize\")",
    "expect(authorize.searchParams.get(\"response_type\")).toBe(\"code\")",
    "expect(authorize.searchParams.get(\"redirect_uri\")).toBe(GATEWAY_CALLBACK)",
    "expect(authorize.href).not.toContain(\"qwork:\")",
    "expect(authorize.href).not.toContain(\"127.0.0.1\")",
    "expect.poll(() => gateway.pollCalls, { timeout: 15_000 }).toBe(2)",
    "expect( detail.getByRole(\"button\", { name: \"停用\", exact: true }), ).toBeVisible({ timeout: 20_000 })",
    "expect .poll(async () => readAdapterProjection(configHome)) .toEqual({ credentialFile: expect.any(String), credential: ACCESS_TOKEN, })",
    "expect(tools.map(({ name }) => name)).toEqual([\"tc_chengxin\"])",
    "expect((await fs.stat(firstProjection.credentialFile)).mode & 0o777).toBe( 0o600, )",
    "expect(await readVaultRecordKeys(configHome)).toHaveLength(1)",
    "expect( page.getByRole(\"button\", { name: \"同程程心，已连接\", exact: true }), ).toBeVisible({ timeout: 4_000 })",
    "expect(await readLines(authUrlSink)).toHaveLength(1)",
    "expect(gateway.startCalls).toBe(1)",
    "expect .poll(async () => readAdapterProjection(configHome)) .toEqual({ credentialFile: expect.any(String), credential: ACCESS_TOKEN, })",
    "expect( page.getByText(\"收到：查询下周出行建议\", { exact: true }), ).toBeVisible()",
    "expect(JSON.stringify(prompt)).toContain(\"MCP 连接器：tc-chengxin\")",
    "expect( page.getByRole(\"button\", { name: \"同程程心，未连接\", exact: true }), ).toBeVisible()",
    "expect.poll(() => gateway.revokeCalls).toBe(1)",
    "expect(gateway.revokeRequests).toEqual([ { access_token: ACCESS_TOKEN, refresh_token: REFRESH_TOKEN, }, ])",
    "expect.poll(async () => readAdapterProjection(configHome)).toBeNull()",
    "expect(bridgeAfterUnbind.mcpServers).not.toHaveProperty(CONNECTOR_ID)",
    "expect .poll(async () => readVaultRecordKeys(configHome)) .toHaveLength(0)",
    "expect( fs.access(firstProjection.credentialFile), ).rejects.toMatchObject({ code: \"ENOENT\", })",
    "expect(state.data?.connectors).not.toHaveProperty(CONNECTOR_ID)",
    "expect( page.getByRole(\"button\", { name: \"同程程心，未连接\", exact: true }), ).toBeVisible()",
    "expect(gateway.startCalls).toBe(1)",
    "expect(gateway.revokeCalls).toBe(1)",
    "expect(await readAdapterProjection(configHome)).toBeNull()",
    "expect(diagnosticText).not.toContain(secret)"
