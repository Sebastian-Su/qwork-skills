  "expected_outcomes": [
    "expect( page.getByRole(\"complementary\", { name: \"个人中心导航\" }), ).toBeVisible()",
    "expect( page.getByRole(\"heading\", { name: \"今日成长任务\" }), ).toBeVisible()",
    "expect( page.getByRole(\"heading\", { name: \"本月活跃地图\" }), ).toBeVisible()",
    "expect(page.locator(\".pc-growth-page\")).toHaveCSS( \"background-color\", \"rgb(250, 250, 250)\", )",
    "expect( page.getByRole(\"complementary\", { name: \"个人中心导航\" }), ).toHaveCSS(\"background-color\", \"rgb(250, 251, 250)\")",
    "expect(page.locator(\".pc-growth-page\")).toHaveCSS( \"background-image\", \"none\", )",
    "expect( page.locator(\".pc-growth-page video[data-pet-source]\"), ).toHaveCount(0)",
    "expect( page.getByRole(\"button\", { name: \"开启盲盒，当前0能量，需要10能量\" }), ).toBeDisabled()",
    "expect(page.getByRole(\"button\", { name: \"打开快递\" })).toHaveCount(0)",
    "expect(page.getByRole(\"button\", { name: /带到桌面/ })).toHaveCount(0)",
    "expect(page.locator(\".pg-content\")).toHaveCSS( \"background-image\", \"none\", )",
    "expect .poll( async () => (await page.evaluate(() => window.workGui.desktopPet.getGrowth())) .completedTasks, ) .toBe(1)",
    "expect .poll( async () => (await page.evaluate(() => window.workGui.desktopPet.getGrowth())) .completedTasks, ) .toBe(index)",
    "expect( page.locator(\".pc-growth-page video[data-pet-source]\"), ).toHaveCount(0)",
    "expect(openButton).toBeEnabled()",
    "expect(page.getByRole(\"slider\")).toHaveCount(0)",
    "expect(page.getByRole(\"button\", { name: \"掀开箱盖\" })).toHaveCount(0)",
    "expect( restored.getByRole(\"heading\", { name: \"新同事报到\" }), ).toBeVisible()",
    "expect(result.ownedIds).toHaveLength(1)",
    "expect .poll(() => revealedPet.evaluate((video: HTMLVideoElement) => video.readyState), ) .toBeGreaterThanOrEqual(2)",
    "expect(revealedPet).toHaveCSS(\"opacity\", \"1\")",
    "expect( page.getByRole(\"button\", { name: \"开启盲盒，当前8能量，需要10能量\" }), ).toBeDisabled()",
    "expect( page.locator(\".pc-growth-page video[data-pet-source]\"), ).toHaveCount(2)",
    "expect( (await running.page.evaluate(() => window.workGui.desktopPet.getGrowth())) .ownedIds, ).toEqual(result.ownedIds)",
    "expect( running.page.getByRole(\"button\", { name: \"打开快递\" }), ).toHaveCount(0)",
    "expect .poll( async () => (await running!.page.evaluate(() => window.workGui.desktopPet.get())) .enabled, ) .toBe(true)"
  ],
