  "expected_outcomes": [
    "expect(page.getByRole(\"heading\", { name: \"QWork，我帮你\" })).toBeVisible()",
    "expect(page.getByTestId(\"global-window-chrome\")).toHaveCount(1)",
    "expect(page.getByTestId(\"window-chrome\")).toHaveCount(0)",
    "expect(page.locator('[data-testid=\"login-status-slot\"] button').first()).toBeVisible()",
    "expect(Math.abs(chrome.height - 30)).toBeLessThanOrEqual(2)",
    "expect(Math.abs(chrome.width - actualViewport.width)).toBeLessThanOrEqual(2)",
    "expect(Math.abs(nativeControlsReserve.x - (actualViewport.width - 138))).toBeLessThanOrEqual(2)",
    "expect(Math.abs(nativeControlsReserve.width - 138)).toBeLessThanOrEqual(2)",
    "expect(mascot.y).toBeGreaterThanOrEqual(chrome.height)",
    "expect(mascot.y + mascot.height).toBeLessThanOrEqual(heading.y + 2)",
    "expect(heading.y + heading.height).toBeLessThanOrEqual(statusSlot.y + 2)",
    "expect(primaryAction.height).toBe(40)",
    "expect(primaryAction.width).toBeGreaterThanOrEqual(180)",
    "expect(statusSlot.y + statusSlot.height).toBeLessThanOrEqual(footer.y)",
    "expect(footer.y + footer.height).toBeLessThanOrEqual(actualViewport.height)",
    "expect(await page.evaluate(() => document.documentElement.scrollHeight)).toBeLessThanOrEqual(actualViewport.height)",
    "expect(Math.abs(menu.width - 200)).toBeLessThanOrEqual(2)",
    "expect(page.getByRole(\"menu\", { name: \"编辑\" })).toBeVisible()",
    "expect(page.getByRole(\"menu\", { name: \"窗口\" })).toBeVisible()",
    "expect(page.getByRole(\"menu\", { name: \"帮助\" })).toBeVisible()",
    "expect(helpMenu.getByRole(\"menuitem\", { name })).toBeVisible()",
    "expect(helpMenu.getByRole(\"menuitem\", { name: \"隐私政策\" })).toHaveCount(0)",
    "expect(helpMenu.getByRole(\"menuitem\", { name: \"服务条款\" })).toHaveCount(0)",
    "expect(page.getByRole(\"menu\")).toHaveCount(0)",
    "expect(page.getByRole(\"menu\", { name: \"编辑\" })).toBeVisible()",
    "expect(page.getByRole(\"menu\", { name: \"QWork\" })).toBeVisible()",
    "expect(page.getByRole(\"menuitem\", { name: \"关于 QWork\" })).toBeFocused()",
    "expect(menuBox).not.toBeNull()",
    "expect(Math.abs(menuBox!.width - 200)).toBeLessThanOrEqual(2)",
    "expect(page.getByRole(\"menuitem\", { name: \"关于 QWork\" })).toHaveCSS(\"background-color\", \"rgb(0, 95, 184)\")",
    "expect(aboutDialog).toBeVisible()",
    "expect(aboutDialog).toContainText(\"版本 0.1.0\")",
    "expect(page.getByLabel(\"Electron\").filter({ hasText: /.+/ })).toBeVisible()",
    "expect(page.getByLabel(\"Chrome\").filter({ hasText: /.+/ })).toBeVisible()",
    "expect(page.getByLabel(\"Node.js\").filter({ hasText: /.+/ })).toBeVisible()",
    "expect(aboutBox).not.toBeNull()",
    "expect(Math.abs(aboutBox!.width - 420)).toBeLessThanOrEqual(2)",
    "expect(aboutDialog).toHaveCount(0)"
  ],
