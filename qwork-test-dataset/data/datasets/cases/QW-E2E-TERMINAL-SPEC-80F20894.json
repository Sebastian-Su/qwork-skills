  "expected_outcomes": [
    "expect( page.getByRole(\"toolbar\", { name: \"对话工具栏\" }), ).toBeVisible()",
    "expect(page.getByTitle(\"新建终端\")).toBeVisible()",
    "expect(page.getByTitle(\"关闭终端\")).toBeVisible()",
    "expect(page.locator(\".xterm:visible\")).toHaveCount(1)",
    "expect .poll(async () => (await copyVisibleTerminal()).trim(), { timeout: 8_000, }) .not.toBe(\"\")",
    "expect.poll(liveTerminalCount).toBe(1)",
    "expect .poll(async () => (await copyVisibleTerminal()).replace(/\\s/g, \"\")) .toContain(\"QWORK_UI_LINE_ONE\")",
    "expect(hasStandaloneLine(beforeEnter, \"QWORK_UI_LINE_ONE\")).toBe(false)",
    "expect(hasStandaloneLine(beforeEnter, \"QWORK_UI_LINE_TWO\")).toBe(false)",
    "expect .poll( async () => { const value = await copyVisibleTerminal(); return ( hasStandaloneLine(value, \"QWORK_UI_LINE_ONE\") && hasStandaloneLine(value, \"QWORK_UI_LINE_TWO\") ); }, { timeout: 8_000 }, ) .toBe(true)",
    "expect(renderedOutput).toMatch( /(?:^|\\r?\\n)QWORK_UI_LINE_ONE[ \\t]*\\r?\\nQWORK_UI_LINE_TWO(?:[ \\t]*\\r?\\n|$)/, )",
    "expect(renderedOutput).toContain(\"QWORK_UI_ANSI\")",
    "expect(renderedOutput).toContain(\"中文\")",
    "expect(page.locator(\".xterm\")).toHaveCount(2)",
    "expect.poll(liveTerminalCount).toBe(2)",
    "expect .poll(async () => (await copyVisibleTerminal()).trim(), { timeout: 8_000, }) .not.toBe(\"\")",
    "expect(page.locator(\".xterm\")).toHaveCount(1)",
    "expect.poll(liveTerminalCount).toBe(1)",
    "expect.poll(copyVisibleTerminal).toContain(\"QWORK_UI_LINE_TWO\")",
    "expect(page.locator(\".xterm\")).toHaveCount(0)",
    "expect.poll(liveTerminalCount).toBe(0)",
    "expect(page.locator(\".xterm:visible\")).toHaveCount(1)",
    "expect.poll(liveTerminalCount).toBe(1)",
    "expect .poll(async () => (await copyVisibleTerminal()).trim(), { timeout: 8_000, }) .not.toBe(\"\")"
  ],
