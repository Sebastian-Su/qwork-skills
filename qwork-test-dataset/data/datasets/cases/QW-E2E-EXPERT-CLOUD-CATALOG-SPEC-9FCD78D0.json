    "expect(catalogOffsets).toEqual([0, 0, 1, 2])",
    "expect(opened.page.getByText(\"收到：准备测试授权弹窗\", { exact: true })).toBeVisible()",
    "expect.poll(() => opened.page.evaluate(async () => (await window.workGui.sessions.list()).length)).toBe(1)",
    "expect(expert).toBeVisible()",
    "expect(permission).toBeVisible()",
    "expect(await permission.evaluate((element) => Number(getComputedStyle(element).zIndex))).toBeGreaterThan(expertLayer)",
    "expect(permission.getByRole(\"region\", { name: \"权限询问\" })).toHaveCSS(\"opacity\", \"1\")",
    "expect.poll(() => permission.evaluate((element) => element.contains(document.activeElement))).toBe(true)",
    "expect(permission).toBeHidden()",
    "expect(expert).toBeHidden()",
    "expect(expert).toBeVisible()",
    "expect.poll(() => opened.page.evaluate(async () => (await window.workGui.sessions.list())[0].status)).toBe(\"idle\")",
    "expect(permission).toBeVisible()",
    "expect(permission).toBeHidden()",
    "expect(expert).toBeVisible()",
    "expect(expert).toBeHidden()",
    "expect(opened.page.getByTestId(\"composer-dock\")).toContainText(packageName)",
    "expect.poll(async () => { const registry = JSON.parse(await fs.readFile( path.join(configHome, \"plugins\", \"installed_plugins.json\"), \"utf8\", )) as { plugins: Record<string, Array<{ version: string }>> }; return registry.plugins[`${packageId}@experts`]?.[0]?.version; }).toBe(\"1.0.0\")",
    "expect(updated.page.getByTestId(\"composer-dock\")).toContainText(packageName)",
    "expect.poll(async () => { const registry = JSON.parse(await fs.readFile( path.join(configHome, \"plugins\", \"installed_plugins.json\"), \"utf8\", )) as { plugins: Record<string, Array<{ version: string }>> }; return registry.plugins[`${packageId}@experts`]?.[0]?.version; }).toBe(\"1.1.0\")",
    "expect.poll(async () => JSON.parse(await fs.readFile( path.join(configHome, \"plugins\", \"marketplaces\", \"experts\", \"plugins\", packageId, \".qwork-plugin/plugin.json\"), \"utf8\", )).package.version).toBe(\"1.1.0\")",
