  "expected_outcomes": [
    "expect.poll(async () => readLines(authUrlSink)).toHaveLength(1)",
    "expect(authorize.origin).toBe(provider.origin)",
    "expect(authorize.pathname).toBe(\"/oauth/authorize\")",
    "expect(authorize.searchParams.get(\"scope\")).toBe( shipped.oauth.scopes?.join(\" \") ?? null, )",
    "expect(authorize.searchParams.get(\"resource\")).toBe( `${provider.origin}/mcp`, )",
    "expect(authorize.searchParams.get(\"code_challenge_method\")).toBe(\"S256\")",
    "expect(authorize.searchParams.get(\"code_challenge\")).toBeTruthy()",
    "expect(redirect).not.toContain(\"qwork://\")",
    "expect(redirect).toMatch( /^http:\\/\\/127\\.0\\.0\\.1:\\d+\\/qconnector\\/tdx-connector\\/oauth\\/callback$/, )",
    "expect(state).toBeTruthy()",
    "expect(provider.registrationRequests).toHaveLength(1)",
    "expect(provider.registrationRequests[0]).toMatchObject({ redirect_uris: [redirect], grant_types: [\"authorization_code\", \"refresh_token\"], response_types: [\"code\"], token_endpoint_auth_method: \"none\", application_type: \"native\", })",
    "expect(callback.status).toBe(200)",
    "expect.poll(() => provider.tokenRequests).toHaveLength(1)",
    "expect(provider.tokenRequests[0].get(\"redirect_uri\")).toBe(redirect)",
    "expect(provider.tokenRequests[0].get(\"resource\")).toBe( `${provider.origin}/mcp`, )",
    "expect( detail.getByRole(\"button\", { name: \"停用\", exact: true }), ).toBeVisible()",
    "expect .poll(async () => (await readMcpLog(mcpLog)).find( (entry) => entry.type === \"mcp_server_upsert\" && (entry.server as { name?: string } | undefined)?.name === \"tdx-connector\", ), ) .toBeTruthy()",
    "expect(event?.server).toEqual( expect.objectContaining({ name: \"tdx-connector\", transport: \"http\", url: `${provider.origin}/mcp`, static_headers: { Authorization: \"Bearer tdx-e2e-access\" }, }), )",
    "expect(event?.server).not.toHaveProperty(\"oauth\")",
    "expect(await readLines(authUrlSink)).toHaveLength(1)"
  ],
