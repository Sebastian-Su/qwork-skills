  "expected_outcomes": [
    "expect(page.getByTestId(\"selected-skill-token\")).toHaveCount(0)",
    "expect((await readSidecarWire(sidecarLog)).some((message) => message.type === \"create_session\" || message.type === \"user_message\")).toBe(false)",
    "expect(page.getByRole(\"textbox\")).toHaveValue(CHAT_APP_PROMPT)",
    "expect((await readSidecarWire(sidecarLog)).some((message) => message.type === \"create_session\")).toBe(false)",
    "expect((await readSidecarWire(sidecarLog)).some((message) => message.type === \"user_message\")).toBe(false)",
    "expect.poll(async () => latestUserMessage(sidecarLog)).toContain(\"@scene:code-03\")",
    "expect(created?.selected_plugins).toEqual([...AGENT_APP_SCENE_PLUGIN_IDS])",
    "expect(created?.selected_skills).toEqual(homeSceneSkillAllowlist(AGENT_APP_SCENE_PLUGIN_IDS))",
    "expect(prompted?.content).toContain(`@scene:code-03\\n\\n${CHAT_APP_PROMPT}`)",
    "expect(prompted?.content).not.toContain(\"skill-claude-agent-web\")",
    "expect(prompted?.content).not.toContain(\"skill-claude-agent-sdk\")",
    "expect(prompted?.selected_plugins).toBeUndefined()",
    "expect(wire.some((message) => message.type === \"set_plugins\")).toBe(false)"
  ],
