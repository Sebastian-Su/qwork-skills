  "expected_outcomes": [
    "expect(turn).toHaveCount(1)",
    "expect(turn).toContainText(\"北京今天晴，最高 30℃。\")",
    "expect(turn.getByText(\"正在查询北京天气。\", { exact: true })).toHaveCount(0)",
    "expect(turn.getByText(\"WebSearch\", { exact: true })).toHaveCount(0)",
    "expect(turn.getByRole(\"button\", { name: \"复制\" })).toHaveCount(1)",
    "expect(userMessage.getByTestId(\"user-message-bubble\")).toContainText( \"查询北京天气并验证单轮回复\", )",
    "expect(userMessage.getByTestId(\"user-message-bubble\").locator(\"p\")).toHaveCSS( \"color\", \"rgb(0, 0, 0)\", )",
    "expect(userToolbar).toHaveCSS(\"opacity\", \"0\")",
    "expect(userToolbar).toHaveCSS(\"opacity\", \"1\")",
    "expect(userToolbar).toContainText(/^\\d{2}:\\d{2}$/)",
    "expect(userToolbar.getByRole(\"button\", { name: \"修改消息\" })).toBeVisible()",
    "expect(userToolbar.getByRole(\"button\", { name: \"复制消息\" })).toBeVisible()",
    "expect.poll(() => page.evaluate(() => window.workGui!.clipboard.readText())).toBe( \"查询北京天气并验证单轮回复\", )",
    "expect(userToolbar.getByRole(\"button\", { name: \"已复制\" })).toBeVisible()",
    "expect(userMessage.getByRole(\"textbox\", { name: \"修改消息内容\" })).toHaveValue( \"查询北京天气并验证单轮回复\", )",
    "expect(disclosure).toHaveAttribute(\"aria-expanded\", \"false\")",
    "expect(disclosure).toHaveAttribute(\"aria-expanded\", \"true\")",
    "expect(turn).toContainText(\"正在查询北京天气。\")",
    "expect(turn).toContainText(\"WebSearch\")",
    "expect(disclosure).toHaveAttribute(\"aria-expanded\", \"false\")",
    "expect.poll(() => page.evaluate(() => window.workGui!.clipboard.readText())).toBe( \"正在查询北京天气。\\n\\n北京今天晴，最高 30℃。\", )",
    "expect(turn.getByRole(\"button\", { name: \"已复制\" })).toHaveAttribute(\"title\", \"已复制\")",
    "expect(turn.getByText(\"已复制\", { exact: true })).toHaveCount(0)",
    "expect.poll(async () => { observedReadAloudState = await readAloudUiState(); return observedReadAloudState; }).toMatch(/^(active|completed|error)$/)",
    "expect.poll(readAloudUiState).toMatch(/^(stopped|completed|error)$/)",
    "expect(like).toHaveAttribute(\"aria-pressed\", \"true\")",
    "expect(feedbackReasons).toBeVisible()",
    "expect(turn.getByRole(\"status\")).toHaveText(\"感谢反馈\")",
    "expect(turn.getByText(\"感谢反馈\", { exact: true })).toHaveCount(0, { timeout: 3_000 })",
    "expect(share).toBeVisible()",
    "expect(share.getByRole(\"checkbox\", { name: \"全选\" })).toBeChecked()",
    "expect(share.getByRole(\"button\", { name: \"复制链接\" })).toBeEnabled()",
    "expect(share.getByRole(\"button\", { name: \"生成二维码\" })).toBeEnabled()",
    "expect(share.getByRole(\"button\", { name: \"浏览器打开\" })).toBeEnabled()",
    "expect(moreMenu.getByRole(\"menuitem\", { name: \"提交反馈\" })).toBeVisible()",
    "expect.poll(() => page.evaluate(() => window.workGui!.clipboard.readText())).not.toBe(\"\")",
    "expect( page.getByTestId(\"user-message-bubble\").filter({ hasText: \"查询北京天气并验证单轮回复\", }), ).toHaveCount(1)",
    "expect(page.getByTestId(/assistant-turn-/)).toHaveCount(1)",
    "expect(page.getByTestId(/assistant-turn-/).getByRole(\"button\", { name: \"复制\" })).toHaveCount(1)"
  ],
