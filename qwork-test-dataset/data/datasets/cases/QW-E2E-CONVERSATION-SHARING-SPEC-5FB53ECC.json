    "expect(panel.getByRole(\"button\", { name: \"复制链接\" })).toBeEnabled()",
    "expect(panel.getByRole(\"button\", { name: \"生成二维码\" })).toBeEnabled()",
    "expect(panel.getByRole(\"button\", { name: \"浏览器打开\" })).toBeEnabled()",
    "expect(panel.getByRole(\"checkbox\", { name: \"全选\" })).toBeChecked()",
    "expect(selectedSurfaces).toHaveCount(2)",
    "expect(surface).toHaveCSS(\"background-color\", \"rgb(242, 242, 242)\")",
    "expect(page.getByRole(\"dialog\", { name: \"确认公开分享内容\" })).toHaveCount(0)",
    "expect(page.getByRole(\"status\").filter({ hasText: \"链接已复制\" })).toContainText(\"链接已复制\")",
    "expect(panel).toHaveCount(0)",
    "expect(shareButton).toHaveAttribute(\"aria-pressed\", \"false\")",
    "expect(page.getByTestId(\"composer-dock\")).toBeVisible()",
    "expect(panel.getByRole(\"checkbox\", { name: \"全选\" })).toBeChecked()",
    "expect(page.getByRole(\"img\", { name: \"分享二维码\" })) .toHaveAttribute(\"data-share-url\", \"https://share.example/assistant-token\")",
    "expect(panel).toHaveCount(0)",
    "expect(panel.getByRole(\"checkbox\", { name: \"全选\" })).toBeChecked()",
    "expect(page.getByRole(\"status\").filter({ hasText: \"已在浏览器打开\" })).toContainText(\"已在浏览器打开\")",
    "expect(panel).toHaveCount(0)",
    "expect(requests).toHaveLength(1)",
    "expect(requests[0].body).toMatchObject({ title: \"本地助理\", snapshot: { renderer: \"conversation\", turns: [{ user: { content: [{ type: \"markdown\", markdown: \"助理分享问题\" }] } }], artifacts: [], }, })",
    "expect.poll(() => page.evaluate(() => window.workGui!.clipboard.readText())) .toBe(\"https://share.example/assistant-token\")",
    "expect.poll(() => app!.evaluate(() => { const state = globalThis as typeof globalThis & { __qworkOpenedExternalUrls?: string[] }; return state.__qworkOpenedExternalUrls; })).toEqual([\"https://share.example/assistant-token\"])",
    "expect(shareButton).toHaveAttribute(\"aria-pressed\", \"false\")",
    "expect(page.getByTestId(\"composer-dock\")).toBeVisible()",
    "expect(page.getByTestId(\"assistant-context-panel\")).toBeVisible()"
