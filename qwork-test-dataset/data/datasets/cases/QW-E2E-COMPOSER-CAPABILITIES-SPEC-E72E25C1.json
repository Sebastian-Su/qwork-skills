  "expected_outcomes": [
    "expect(modeMenu).toBeVisible()",
    "expect(modeMenu).toHaveCSS(\"width\", \"200px\")",
    "expect(modeMenu).toHaveCSS(\"height\", \"148px\")",
    "expect(modeMenu).toContainText(\"当前为默认模式，可高效执行并完成任务。\")",
    "expect(plan).toHaveAttribute(\"aria-checked\", \"false\")",
    "expect(ask).toHaveAttribute(\"aria-checked\", \"false\")",
    "expect(ask).toHaveAttribute(\"aria-checked\", \"true\")",
    "expect(modeMenu).toContainText( \"当前为问答模式，适合问问题，找思路，无法做执行。\", )",
    "expect(page.getByRole(\"status\", { name: \"当前模式\" })).toHaveText(\"仅问答\")",
    "expect(page.getByRole(\"button\", { name: \"默认权限\" })).toBeVisible()",
    "expect(page.getByText(\"收到：只分析当前项目\", { exact: true })).toBeVisible()",
    "expect(thirdRootMenu).toBeVisible()",
    "expect(existingAsk).toHaveAttribute(\"aria-checked\", \"true\")",
    "expect(existingPlan).toHaveAttribute(\"aria-checked\", \"true\")",
    "expect(page.getByText(\"收到：先制定实施计划\", { exact: true })).toBeVisible()",
    "expect.poll(async () => { if ((await moreButton.getAttribute(\"aria-expanded\")) !== \"true\") { await moreButton.click(); } return moreButton.getAttribute(\"aria-expanded\"); }).toBe(\"true\")",
    "expect(finalRootMenu).toBeVisible()",
    "expect(askAgain).toHaveAttribute(\"aria-checked\", \"true\")",
    "expect( page.getByText(\"收到：再次只分析当前项目\", { exact: true }), ).toBeVisible()",
    "expect.poll(async () => { try { return (await fs.readFile(eventLog, \"utf8\")) .trim() .split(/\\r?\\n/) .filter(Boolean) .map((line) => JSON.parse(line) as { type: string; content?: string; permission_mode?: string; ref?: string; direction?: string; }); } catch { return []; } }).toEqual(expect.arrayContaining([ expect.objectContaining({ type: \"create_session\", permission_mode: \"plan\", }), expect.objectContaining({ type…",
    "expect( controls.some((message) => message.permission_mode === \"ask\"), ).toBe(false)",
    "expect(createIndex).toBeGreaterThanOrEqual(0)",
    "expect(firstPromptIndex).toBeGreaterThan(createIndex)",
    "expect(controls[firstPromptIndex]?.content).toMatch(/仅回答问题.*不得执行/s)",
    "expect(secondPromptIndex).toBeGreaterThan(firstPromptIndex)",
    "expect(controls[secondPromptIndex]?.content).not.toContain( \"<qwork_conversation_mode>\", )",
    "expect(thirdPromptIndex).toBeGreaterThan(secondPromptIndex)",
    "expect(controls[thirdPromptIndex]?.content).toMatch(/仅回答问题.*不得执行/s)"
  ],
