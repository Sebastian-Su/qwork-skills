    "expect(page.getByTestId(\"global-window-drag-surface\")).toHaveCSS(\"-webkit-app-region\", \"drag\")",
    "expect(page.getByRole(\"region\", { name: \"登录\" })).toHaveCSS(\"-webkit-app-region\", \"none\")",
    "expect(page.getByTestId(\"global-window-controls\")).toHaveCount(0)",
    "expect(nativeControlsReserve).toBeVisible()",
    "expect(reserveBox).not.toBeNull()",
    "expect(Math.abs(reserveBox!.width - 138)).toBeLessThanOrEqual(2)",
    "expect(page.getByRole(\"menu\", { name: \"帮助\" })).toBeVisible()",
    "expect(page.getByRole(\"menu\", { name: \"帮助\" })).toHaveCount(0)",
    "expect(await aboutMenuItem.evaluate((element) => element.closest('[data-testid=\"global-window-chrome\"]') === null, )).toBe(true)",
    "expect(aboutMenuItem.locator(\"span\").first()).toHaveCSS(\"-webkit-app-region\", \"no-drag\")",
    "expect(aboutDialog).toBeVisible()",
    "expect(aboutDialog).toBeVisible()",
    "expect(aboutDialog).toContainText(\"版本 0.1.0\")",
    "expect(page.getByLabel(\"Electron\").filter({ hasText: /.+/ })).toBeVisible()",
    "expect(aboutDialog).toHaveCount(0)"
