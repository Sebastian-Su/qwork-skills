  "expected_outcomes": [
    "expect.poll(() => app!.windows().length).toBe(2)",
    "expect.poll(() => app!.windows().length).toBe(1)",
    "expect(page.getByText(\"已取消登录，可重新发起。\")).toBeVisible()",
    "expect(page.getByRole(\"button\", { name: \"重新登录\" })).toBeFocused()",
    "expect(page.getByRole(\"menubar\", { name: \"应用菜单\" })).toHaveCount(0)",
