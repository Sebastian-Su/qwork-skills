  "expected_outcomes": [
    "expect(page.getByRole(\"heading\", { name: \"内置技能\", level: 1 })).toBeVisible()",
    "expect(builtinCards.first()).toBeVisible()",
    "expect(longestBuiltinName.length).toBeGreaterThan(20)",
    "expect(builtinHeader).toHaveCSS(\"padding-right\", \"44px\")",
    "expect(builtinHeader).toHaveCSS(\"padding-right\", \"88px\")",
    "expect(builtinHeader).toHaveCSS(\"padding-right\", \"44px\")",
    "expect(builtinHeader).toHaveCSS(\"padding-right\", \"88px\")",
    "expect(titleBox.right).toBeLessThanOrEqual(badgeBox.x)",
    "expect(moreBox.x - badgeBox.right).toBeGreaterThanOrEqual(6)",
    "expect(moreBox.x - badgeBox.right).toBeLessThanOrEqual(10)",
    "expect(badgeBox.right).toBeLessThanOrEqual(pinBox.x)",
    "expect(builtinHeaderCenterSpread).toBeLessThanOrEqual(2)",
    "expect(toggleBox.x - badgeBox.right).toBeLessThanOrEqual(toggleBox.width * 2.25)",
    "expect(descriptionBox.right).toBeGreaterThanOrEqual(toggleBox.x)",
    "expect(await computedStyle(badge, [\"white-space\"])).toEqual({ \"white-space\": \"nowrap\" })",
    "expect(descriptionTooltip).toHaveText(fullDescription ?? \"\", { timeout: 2_000 })",
    "expect(descriptionTooltip).toHaveCSS(\"background-color\", \"rgb(255, 255, 255)\")",
    "expect(search).toBeVisible()",
    "expect(skill).toBeVisible()",
    "expect(page.getByRole(\"article\", { name: /skill-creator.*内置技能/i })).toHaveCount(1)",
    "expect(page.getByText(\"卸载\", { exact: true })).toHaveCount(0)",
    "expect(await computedStyle(skill.getByText(\"内置\", { exact: true }), [\"white-space\"])).toEqual({ \"white-space\": \"nowrap\", })",
    "expect(toggle).not.toBeChecked()",
    "expect(menu.getByRole(\"menuitem\", { name: \"去对话\" })).toBeDisabled()",
    "expect(menu.getByRole(\"menuitem\", { name: \"打开文件夹\" })).toBeVisible()",
    "expect(page.getByRole(\"menuitem\", { name: \"卸载\" })).toHaveCount(0)",
    "expect(picker).toBeVisible()",
    "expect(picker.getByText(\"正在加载技能…\", { exact: true })).toHaveCount(0)",
    "expect(picker.getByRole(\"option\", { name: /skill-creator/i })).toHaveCount(0)",
    "expect(persistedToggle).not.toBeChecked()",
    "expect(page.getByRole(\"switch\", { name: \"关闭 skill-creator\" })).toBeChecked()",
    "expect.poll(async () => page.evaluate(async () => (await window.workGui.skills.scanManaged()).find( (item) => item.id === \"skill-creator\", ), ), ).toMatchObject({ id: \"skill-creator\", active: true, available: true, })",
    "expect(enabledPicker).toBeVisible()",
    "expect(enabledPicker.getByText(\"正在加载技能…\", { exact: true })).toHaveCount(0)",
    "expect(enabledPicker.getByRole(\"option\", { name: /skill-creator/i })).toBeVisible()"
