  "expected_outcomes": [
    "expect(addActions).toHaveCount(1)",
    "expect(addActions).toHaveCSS(\"background-color\", \"rgba(0, 0, 0, 0.9)\")",
    "expect(addActions).toHaveCSS(\"color\", \"rgb(255, 255, 255)\")",
    "expect(addActions).toHaveCSS(\"border-radius\", \"8px\")",
    "expect(page.getByRole(\"heading\", { name: \"自动化任务模版\", exact: true })).toBeVisible()",
    "expect(page.getByTestId(\"page-surface\")).toHaveAttribute(\"data-page-chrome-mode\", \"integrated\")",
    "expect(page.getByTestId(\"automation-template-card\")).toHaveCount(12)",
    "expect(page.getByRole(\"button\", { name: /每日 AI 新闻推送/ })).toBeVisible()",
    "expect(page.getByRole(\"textbox\", { name: \"名称\", exact: true })).toHaveValue(\"每日 AI 新闻推送\")",
    "expect(modelMenu).toHaveAttribute(\"aria-expanded\", \"true\")",
    "expect(modelMenu).toHaveAttribute(\"aria-expanded\", \"false\")",
    "expect(skillMenu).toHaveAttribute(\"aria-expanded\", \"true\")",
    "expect(skillMenu).toHaveAttribute(\"aria-expanded\", \"false\")",
    "expect(page.getByText(\"自动化任务执行时，请勿关闭电脑或退出客户端，否则任务将无法正常执行\")).toBeVisible()",
    "expect(page.getByRole(\"radiogroup\", { name: \"执行频率类型\" })).toBeVisible()",
    "expect(page.getByRole(\"button\", { name: \"周期频率\" })).toContainText(\"每天\")",
    "expect(calendar).toHaveCSS(\"width\", \"340px\")",
    "expect(calendar).toHaveCSS(\"height\", \"373px\")",
    "expect(validity).toContainText(\"2026/08/12 —\")",
    "expect(validity).toContainText(\"2026/08/12 — 2026/08/15\")",
    "expect(page.getByText(\"每日 AI 新闻推送\", { exact: true })).toBeVisible()",
    "expect(moreMenu).toHaveAttribute(\"aria-expanded\", \"true\")",
    "expect(moreMenu).toHaveAttribute(\"aria-expanded\", \"false\")",
    "expect(page.getByRole(\"button\", { name: \"恢复\", exact: true })).toBeVisible()",
    "expect(page.getByText(\"E2E 模板日报\", { exact: true })).toBeVisible()",
    "expect(page.getByTestId(\"composer-dock\")).toBeVisible({ timeout: 15_000 })",
    "expect(runButton).toBeVisible({ timeout: 15_000 })",
    "expect(page.getByText(\"测试运行完成\", { exact: true }).first()).toBeVisible({ timeout: 15_000 })",
    "expect(page.getByTestId(\"composer-dock\")).toBeVisible()",
    "expect(page.getByRole(\"button\", { name: \"永久删除 E2E 模板日报\" })).toBeVisible()",
    "expect(page.getByRole(\"button\", { name: \"永久删除 E2E 模板日报\" })).not.toBeVisible()",
    "expect(page.getByText(\"已选择 2 项\", { exact: true })).toBeVisible()",
    "expect(page.getByText(\"开启你的第一个自动化任务吧\")).toBeVisible()"
