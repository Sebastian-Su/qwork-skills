  "expected_outcomes": [
    "expect(page.getByText(\"收到：建立多行输入测试会话\", { exact: true })).toBeVisible()",
    "expect(geometry.editor.height).toBe(128)",
    "expect(geometry.editorOverflow).toBe(\"hidden\")",
    "expect(geometry.textarea.height).toBe(80)",
    "expect(geometry.textarea.bottom).toBeLessThanOrEqual(geometry.toolbar.top - 4)",
    "expect(geometry.textarea.scrollHeight).toBeGreaterThan(geometry.textarea.clientHeight)",
    "expect(geometry.textarea.overflowY).toBe(\"auto\")",
    "expect(geometry.toolbar.top).toBeGreaterThanOrEqual(geometry.editor.top)",
    "expect(geometry.toolbar.bottom).toBeLessThanOrEqual(geometry.editor.bottom + 0.5)",
    "expect(page.getByRole(\"button\", { name: \"收起输入框\" })).toHaveAttribute( \"aria-expanded\", \"true\", )",
    "expect(expandedGeometry.editor.height).toBeGreaterThanOrEqual(300)",
    "expect(Math.abs(expandedGeometry.editor.bottom - collapsedBottom)).toBeLessThanOrEqual(2)",
    "expect(expandedGeometry.textarea.bottom).toBeLessThanOrEqual(expandedGeometry.toolbar.top - 4)",
    "expect(page.getByRole(\"button\", { name: \"展开输入框\" })).toHaveAttribute( \"aria-expanded\", \"false\", )",
    "expect(composer).toHaveValue(`${multiline}\\n展开后继续编辑，草稿不能丢失`)",
    "expect( page.getByText(\"展开后继续编辑，草稿不能丢失\", { exact: false }), ).toBeVisible()"
  ],
