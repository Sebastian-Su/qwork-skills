    "expect(panel.getByRole(\"checkbox\", { name: \"全选\" })).toBeChecked()",
    "expect(selectedSurfaces).toHaveCount(4)",
    "expect(surface).toHaveCSS(\"background-color\", \"rgb(242, 242, 242)\")",
    "expect(page.locator('[data-testid^=\"user-message-toolbar-\"]').first()).toHaveCSS(\"display\", \"none\")",
    "expect(assistantCheckboxBox).not.toBeNull()",
    "expect(assistantSurfaceBox).not.toBeNull()",
    "expect(assistantCheckboxBox!.y - assistantSurfaceBox!.y).toBe(12)",
    "expect(page.getByRole(\"dialog\", { name: \"确认公开分享内容\" })).toHaveCount(0)",
    "expect(page.getByRole(\"status\").filter({ hasText: \"链接已复制\" })).toContainText(\"链接已复制\")",
    "expect(page.getByRole(\"img\", { name: \"分享二维码\" })).toBeVisible()",
    "expect(page.getByRole(\"img\", { name: \"分享二维码\" })).toHaveCount(0)",
    "expect(page.getByRole(\"status\").filter({ hasText: \"已在浏览器打开\" })).toContainText(\"已在浏览器打开\")",
    "expect.poll(() => app!.evaluate(() => { const state = globalThis as typeof globalThis & { __qworkOpenedExternalUrls?: string[] }; return state.__qworkOpenedExternalUrls; })).toEqual([\"https://share.example/token-1\"])",
    "expect(requests).toHaveLength(1)",
    "expect(requests[0].headers[\"idempotency-key\"]).toBeTruthy()",
    "expect(requests[0].body).toMatchObject({ snapshot: { renderer: \"conversation\", turns: [{ user: { content: [{ type: \"markdown\", markdown: \"第一问\" }] } }, { user: { content: [{ type: \"markdown\", markdown: \"第二问\" }] } }], artifacts: [] }, })",
    "expect.poll(() => page.evaluate(() => window.workGui!.clipboard.readText())).toBe(\"https://share.example/token-1\")",
    "expect.poll(() => requests.length).toBe(2)",
    "expect(requests[1].body).toMatchObject({ snapshot: { renderer: \"conversation\", turns: [{ user: { content: [{ type: \"markdown\", markdown: \"第一问\" }] } }], artifacts: [] }, })"
