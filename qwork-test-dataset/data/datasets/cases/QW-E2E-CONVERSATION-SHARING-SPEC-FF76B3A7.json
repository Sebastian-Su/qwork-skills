    "expect(panel.getByRole(\"checkbox\", { name: \"全选\" })).not.toBeChecked()",
    "expect(page.getByRole(\"status\").filter({ hasText: \"没有可分享的内容\" })).toContainText(\"没有可分享的内容\")",
