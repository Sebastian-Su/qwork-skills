  "expected_outcomes": [
    "expect(samples.length).toBeGreaterThan(5)",
    "expect(samples.every((sample) => sample.x >= 76)).toBe(true)",
    "expect(samples.some((sample) => sample.trafficLightHit)).toBe(false)",
    "uiExpect.soft(page.getByRole(\"button\", { name: \"展开侧栏\", exact: true })).toBeVisible()",
    "expect.poll(async () => (await boxOf(sidebar)).width).toBe(0)",
    "uiExpect.soft(sidebar).toHaveAttribute(\"aria-hidden\", \"true\")",
    "uiExpect.soft(sidebar).toHaveAttribute(\"inert\", \"\")",
    "uiExpect.soft(page.getByRole(\"button\", { name: \"新建任务\", exact: true })).toBeHidden()",
    "uiExpect.soft(await computedStyle(sidebar, [\"transition-duration\", \"transition-timing-function\", \"pointer-events\"])) .toEqual({ \"transition-duration\": \"0.25s\", \"transition-timing-function\": \"ease-out\", \"pointer-events\": \"none\", })",
    "expect.poll(async () => (await boxOf(sidebar)).width).toBe(264)",
    "uiExpect.soft(sidebar).toHaveAttribute(\"aria-hidden\", \"false\")",
    "uiExpect.soft(sidebar).not.toHaveAttribute(\"inert\")",
    "expect.poll(async () => (await boxOf(sidebar)).width).toBe(0)",
    "uiExpect.soft(sidebar).toHaveCSS(\"transition-duration\", \"0s\")",
    "expect.poll(async () => (await boxOf(sidebar)).width).toBe(264)"
  ],
