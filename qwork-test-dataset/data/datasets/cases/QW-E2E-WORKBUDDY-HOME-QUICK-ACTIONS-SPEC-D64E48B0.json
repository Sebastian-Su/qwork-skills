  "expected_outcomes": [
    "expect(await page.getByRole(\"button\").allTextContents()).toEqual(expect.arrayContaining([ \"文档处理\", \"金融服务\", \"数据分析及可视化\", \"个人工作台\", \"幻灯片\", \"深度研究\", \"视频生成\", \"产品管理\", ]))",
    "expect(page.getByRole(\"button\", { name: \"文档处理\" }).locator(\"[data-icon-key]\")).toHaveAttribute(\"data-icon-key\", \"file-text\")",
    "expect(page.getByRole(\"button\", { name: \"金融服务\" }).locator(\"[data-icon-key]\")).toHaveAttribute(\"data-icon-key\", \"briefcase\")",
    "expect(page.getByRole(\"button\", { name: \"个人工作台\" }).locator(\"[data-icon-key]\")).toHaveAttribute(\"data-icon-key\", \"layout\")",
    "expect.poll(() => row.getAttribute(\"data-scroll-left\")).toBe(\"0\")",
    "expect.poll(() => row.getAttribute(\"data-scroll-left\")).toBe(\"120\")",
    "expect.poll(() => row.getAttribute(\"data-scroll-left\")).toBe(\"0\")",
    "expect.poll(() => row.getAttribute(\"data-scroll-left\")).toBe(\"200\")",
    "expect.poll(() => row.getAttribute(\"data-scroll-left\")).toBe(\"232\")",
    "expect(page.getByRole(\"button\", { name: \"更多快捷项\" })).toHaveCount(0)",
    "expect.poll(() => row.getAttribute(\"data-scroll-left\")).toBe(\"32\")",
    "expect.poll(() => row.getAttribute(\"data-scroll-left\")).toBe(\"0\")",
    "expect(page.getByRole(\"textbox\")).toHaveValue(composeHomeTemplatePrompt( \"daily-01\", \"帮我把【上传的 Markdown 文件】转换成排版精美的 PDF 文档，要求：自定义封面页（标题 + 作者 + 日期）、自动生成目录、代码块带语法高亮、表格有交替行底色、页脚显示页码。\", ))",
    "expect(page.getByText(\"暂未实现\")).toHaveCount(0)",
    "expect(page.getByText(\"视频生成专家\")).toBeVisible()",
    "expect(page.getByTestId(\"home-quick-action-template\")).toHaveCount(4)",
    "expect(page.getByRole(\"dialog\", { name: \"替换当前草稿\" })).toBeVisible()",
    "expect(page.getByRole(\"textbox\")).toHaveValue(\"这是我的手工草稿\")",
    "expect(page.getByRole(\"textbox\")).toHaveValue(\"帮我生成一条 OpenClaw 的介绍视频\")",
    "expect(page.getByText(\"视频生成专家\")).toBeVisible()"
  ],
