  "expected_outcomes": [
    "expect(switchBoxBefore).not.toBeNull()",
    "expect.poll(async () => Math.round((await desktopPetSwitch.boundingBox())?.y ?? -1)) .toBe(Math.round(switchBoxBefore?.y ?? -1))",
    "expect(petPage.getByRole(\"button\", { name: \"唤醒被窝团子\" })).toBeVisible()",
    "expect(petPage.locator(\"[data-action-count='20']\")).toBeVisible()",
    "expect(motionCanvas).toHaveAttribute(\"data-motion-renderer\", \"source-mesh\")",
    "expect(motionCanvas).toHaveAttribute(\"data-frame-ready\", \"true\")",
    "expect.poll(() => motionCanvas.getAttribute(\"data-playhead\")).not.toBe(\"0.000\")",
    "expect(alpha.solid).toBeGreaterThan(1500)",
    "expect(alpha.transparent).toBeGreaterThan(1500)",
    "expect(petPage.getByRole(\"dialog\", { name: \"桌宠状态\" })).toBeVisible()",
    "expect(petPage.getByText(\"待机陪伴\")).toBeVisible()",
    "expect.poll(async () => app.evaluate(({ BrowserWindow }) => { const target = BrowserWindow.getAllWindows().find((window) => window.webContents.getURL().includes(\"surface=desktop-pet\"), ); if (!target) throw new Error(\"desktop pet window missing\"); return target.getBounds().x; })).toBe(directDragBefore.x - 42)",
    "expect(motionCanvas).toHaveAttribute(\"data-response\", \"hover\")",
    "expect.poll(async () => Number(await motionCanvas.getAttribute(\"data-playhead\"))).not.toBe(before)",
    "expect(motionCanvas).toHaveAttribute(\"data-response\", \"idle\")",
    "expect(petPage.getByTestId(\"desktop-pet-art\")).toHaveAttribute( \"data-tap-motion\", \"preserve-pose\", )",
    "expect(petPage.locator(\"[data-pet-tap-count='1']\")).toBeVisible()",
    "expect(petPage.getByRole(\"status\", { name: \"桌宠回应\" })).toContainText(\"哼…再摸一下\")",
    "expect(petPage.getByRole(\"region\", { name: \"桌宠对话\" })).toBeVisible()",
    "expect(expandedBounds.x + expandedBounds.width).toBe(closedBounds.x + closedBounds.width)",
    "expect(expandedBounds.y + expandedBounds.height).toBe(closedBounds.y + closedBounds.height)",
    "expect(petPage.getByRole(\"button\", { name: \"唤醒困困\" })).toBeVisible()",
    "expect(petPage.getByText(/收到：.*陪我把今天熬过去/)).toBeVisible({ timeout: 10_000 })",
    "expect((await state).sessionId).toBeTruthy()",
    "expect((await state).profile).toEqual({ characterId: \"blanket-blob\", name: \"困困\", personality: \"laid-back\", genderExpression: \"neutral\", })",
    "expect.poll(async () => { const next = await petPage.evaluate(() => window.workGui.desktopPet.get()); return next.position; }).toEqual(moved)"
  ],
