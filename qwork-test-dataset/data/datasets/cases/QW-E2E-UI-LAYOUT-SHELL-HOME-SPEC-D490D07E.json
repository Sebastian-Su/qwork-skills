    "expect(page.locator(\"html\")).toHaveClass(/dark/)",
    "expect(computedStyle(saveDialog, [\"background-color\", \"border-radius\"])) .resolves.toEqual({ \"background-color\": \"rgb(24, 24, 24)\", \"border-radius\": \"12px\" })",
