    "expect(computedStyle(row.locator(\"button > span\").first(), [\"font-size\", \"font-weight\", \"line-height\"])) .resolves.toEqual({ \"font-size\": \"14px\", \"font-weight\": \"600\", \"line-height\": \"21px\" })",
    "expect(row.getByTestId(\"task-last-activity\")).toHaveText(/刚刚|分钟前/)",
    "expect(row.getByRole(\"button\", { name: /更多操作：任务行操作验收/ })).toBeHidden()",
    "expect(row.getByTestId(\"task-last-activity\")).toBeHidden()",
    "expect(action).toBeVisible()",
    "expect(menu).toBeVisible()",
    "expect(computedStyle(menu, [\"border-width\", \"border-radius\", \"padding\"])) .resolves.toEqual({ \"border-width\": \"0.5px\", \"border-radius\": \"16px\", padding: \"8px\" })",
    "expect(menu.getByRole(\"menuitem\").allTextContents()).resolves.toEqual([ \"打开文件夹\", \"重命名\", \"保存到工作空间\", \"分享任务\", \"删除任务\", ])",
    "expect(computedStyle(item, [\"border-radius\", \"font-size\", \"font-weight\", \"line-height\"])) .resolves.toEqual({ \"border-radius\": \"8px\", \"font-size\": \"14px\", \"font-weight\": \"400\", \"line-height\": \"22px\" })",
    "expect(menu.getByRole(\"menuitem\").first()).not.toBeFocused()",
    "expect(renameTime).toBeVisible()",
    "expect(stableRow.getByTestId(\"task-actions\")).toBeHidden()",
    "expect(renameTimeBox.x - renameInputBox.right).toBeCloseTo(8, 1)",
    "expect(renameRowBox.right - renameTimeBox.right).toBeCloseTo(12, 1)",
    "expect(computedStyle(renameInput, [\"padding\", \"font-size\", \"line-height\", \"border-radius\"])) .resolves.toEqual({ padding: \"0px 4px\", \"font-size\": \"13px\", \"line-height\": \"18px\", \"border-radius\": \"4px\" })",
    "expect(stableRow.locator(\"button > span\").first()).toHaveText(\"任务行操作验收-已重命名\")",
    "expect(row).toBeVisible()",
    "expect(shareRegion).toBeVisible()",
