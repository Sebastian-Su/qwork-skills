  "expected_outcomes": [
    "expect(page.getByRole(\"heading\", { name: \"项目\", exact: true })).toBeVisible()",
    "expect(page.getByText(\"QWork 项目新手指引\")).toBeVisible()",
    "expect(page.getByRole(\"button\", { name: \"发布留言\" })).toBeVisible()",
