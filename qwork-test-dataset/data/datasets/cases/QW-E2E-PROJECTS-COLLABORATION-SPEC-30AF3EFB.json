    "expect(tabs.getByRole(\"tab\", { name, exact: true })).toBeVisible()",
    "expect(page.getByRole(\"button\", { name: \"发布留言\" })).toHaveCount(0)",
    "expect( planViews.getByRole(\"tab\", { name: \"列表\", exact: true }), ).toHaveAttribute(\"aria-selected\", \"true\")",
    "expect(page.getByRole(\"region\", { name: \"列表\" })).toBeVisible()",
    "expect(page.getByRole(\"table\", { name: \"待办表格\" })).toContainText( \"E2E 待办\", )",
    "expect(board.getByRole(\"group\", { name: \"待开始\" })).toContainText( \"E2E 待办\", )",
    "expect(board.getByRole(\"group\", { name: \"进行中\" })).toContainText( \"E2E 待办\", )",
    "expect(gantt.getByText(\"标题\")).toBeVisible()",
    "expect( gantt.getByRole(\"button\", { name: \"E2E 排期 甘特条\", exact: true }), ).toBeVisible()",
    "expect(calendar).toBeVisible()",
    "expect(calendar.getByText(\"E2E 排期\")).toBeVisible()",
    "expect( page.getByText(\"你的任务是私密的，除非你共享它们\"), ).toBeVisible()",
    "expect(page.getByRole(\"list\", { name: \"任务列表\" })).toContainText( \"E2E 任务\", )",
    "expect(page.getByRole(\"button\", { name: \"升级\", exact: true })).toHaveCount(0)",
    "expect(storageTooltip).toContainText(\"由360网盘提供存储服务\")",
    "expect(storageTooltip).toContainText(\"我的云端网盘和项目资产共同使用\")",
    "expect(storageTooltip).not.toContainText(\"腾讯\")",
    "expect(page.getByLabel(\"资产文件夹\")).toContainText(\"E2E 文件夹\")",
    "expect(page.getByRole(\"button\", { name: \"发布留言\" })).toBeVisible()",
    "expect(overlay).toBeVisible()",
    "expect(overlay.getByText(\"所有者\")).toBeVisible()",
    "expect( overlay.getByRole(\"button\", { name: \"申请后加入\" }), ).toBeEnabled()",
    "expect(page.getByText(\"已复制邀请链接\")).toBeVisible()",
    "expect(inviteLink).toMatch(/^qwork:\\/\\/invite\\/[^/]+$/)"
