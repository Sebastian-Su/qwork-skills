  "expected_outcomes": [
    "expect(page.getByText(/已插入场景|已填入/)).toHaveCount(0)",
    "expect(page.getByRole(\"button\", { name: \"DCF估值模型\" }).locator(\"[data-icon-key]\")).toHaveCount(0)",
    "expect(page.getByRole(\"button\", { name: \"DCF估值模型\" }).getByTestId(\"home-quick-action-template-arrow\")).toBeVisible()",
    "expect(phrase).toHaveAttribute(\"data-scene-uri\", \"scene://daily-02\")",
    "expect(page.getByRole(\"button\", { name: \"移除场景 金融服务\" })).toBeVisible()",
    "expect(page.getByRole(\"textbox\")).toHaveValue(\"\")",
    "expect(page.getByRole(\"button\", { name: \"发送\" })).toBeDisabled()",
    "expect(page.getByRole(\"textbox\")).not.toHaveValue(\"金融服务\")",
    "expect(page.getByRole(\"textbox\")).toHaveValue(DCF_PROMPT)",
    "expect(phrase).toHaveAttribute(\"data-scene-uri\", \"scene://daily-02\")",
    "expect(page.getByRole(\"textbox\")).not.toHaveValue(/@scene:/)",
    "expect.poll(async () => { const raw = await fs.readFile(sidecarLog, \"utf8\").catch(() => \"\"); return raw .split(/\\r?\\n/) .filter(Boolean) .map((line) => JSON.parse(line) as { type?: string; content?: string }) .find((message) => message.type === \"user_message\")?.content ?? \"\"; }).toMatch( new RegExp( `(^|\\\\n)@scene:daily-02\\\\r?\\\\n\\\\r?\\\\n${escapeRegExp(DCF_PROMPT)}(\\\\n<qwork_selected_connector_invocation[\\\\s\\\\S]*)?$`,…",
    "expect(page.getByTestId(\"user-message\")).toBeVisible()",
    "expect(page.getByTestId(\"user-message-bubble\").getByTestId(\"scene-phrase\")).toHaveAttribute( \"data-scene-uri\", \"scene://daily-02\", )",
    "expect(page.getByTestId(\"user-message-bubble\").getByText(\"金融服务\")).toBeVisible()",
    "expect(page.getByTestId(\"user-message-bubble\").getByText(DCF_PROMPT)).toBeVisible()",
    "expect(page.getByTestId(\"user-message-bubble\").getByText(\"@scene:daily-02\")).toHaveCount(0)",
    "expect(page.getByRole(\"textbox\")).toHaveValue(\"\")",
    "expect(page.getByTestId(\"dialog-thread-title\")).not.toContainText(\"@scene:\")",
    "expect(page.getByTestId(\"dialog-thread-title\")).toContainText(\"构建一个完整的 DCF 模型\")"
