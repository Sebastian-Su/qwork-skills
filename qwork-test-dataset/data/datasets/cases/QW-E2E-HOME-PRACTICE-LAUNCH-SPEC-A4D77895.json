  "expected_outcomes": [
    "expect(detail).toBeVisible()",
    "expect.poll(async () => detail.evaluate((element) => { const animations = element.parentElement?.getAnimations() ?? []; return animations.length > 0 && animations.every((animation) => animation.playState === \"finished\"); })).toBe(true)",
    "expect(detailBox).toBeTruthy()",
    "expect(Math.abs(detailBox.width - 640)).toBeLessThanOrEqual(2)",
    "expect(Math.abs(detailBox.height - 644)).toBeLessThanOrEqual(2)",
    "expect(detail).toContainText(ORDERS.summary)",
    "expect(detail.getByRole(\"tooltip\")).toContainText(ORDERS.summary)",
    "expect(detail.getByRole(\"tooltip\")).not.toContainText(ORDERS.prompt)",
    "expect(detail.getByRole(\"button\", { name: \"添加收藏\" })).toBeVisible()",
    "expect(detail.getByRole(\"button\", { name: \"最大化预览\" })).toBeVisible()",
    "expect(cta).toBeVisible()",
    "expect(ctaBox).toBeTruthy()",
    "expect(Math.abs(ctaBox.width - 126)).toBeLessThanOrEqual(2)",
    "expect(Math.abs(ctaBox.height - 32)).toBeLessThanOrEqual(2)",
    "expect(page.getByText(\"任务 (0)\", { exact: true })).toBeVisible()",
    "expect(await sidecarPromptCount(sidecarLog)).toBe(0)",
    "expect(detail.getByRole(\"button\", { name: \"最小化预览\" })).toBeVisible()",
    "expect(detail.getByTestId(\"home-practice-preview-title\")).toHaveText(\"Orders API Reference\")",
    "expect(detail.getByRole(\"button\", { name: \"切换至中文预览\" })).toHaveText(\"中\")",
    "expect(detail.getByRole(\"button\", { name: \"取消收藏\" })).toBeVisible()",
    "expect(detail).toHaveCount(0)",
    "expect(composer).toHaveValue(ORDERS.prompt)",
    "expect(composer).toBeFocused()",
    "expect(page.getByRole(\"button\", { name: \"移除技术文档工程师\" })).toBeVisible()",
    "expect(page.getByText(\"任务 (0)\", { exact: true })).toBeVisible()",
    "expect(await sidecarPromptCount(sidecarLog)).toBe(0)",
    "expect(requests.some((url) => /playbook|myqcloud\\.com|cos\\./i.test(url))).toBe(false)"
  ],
