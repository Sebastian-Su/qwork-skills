  "steps": [
    {
      "action": "launch isolated QWork Electron"
    },
    {
      "action": "composer.fill(\"用一句话介绍你自己，你叫什么，能做什么\")"
    },
    {
      "action": "composer.press(\"Enter\")"
    },
    {
      "action": "like.click()"
    },
    {
      "action": "dislike.click()"
    },
    {
      "action": "feedbackReasons.getByRole(\"option\", { name: \"理解错误\" }).click()"
    },
    {
      "action": "feedbackReasons.getByRole(\"button\", { name: \"提交反馈\" }).click()"
    },
    {
      "action": "more.click()"
    },
    {
      "action": "moreMenu.getByRole(\"menuitem\", { name: \"提交反馈\" }).click()"
    },
    {
      "action": "moreFeedbackReasons.getByRole(\"option\", { name: \"回答不清晰\" }).click()"
    },
    {
      "action": "moreFeedbackReasons.getByRole(\"button\", { name: \"提交反馈\" }).click()"
    },
    {
      "action": "assistantMessage.getByRole(\"button\", { name: \"分享\", exact: true }).click()"
    },
    {
      "action": "sharePanel.getByRole(\"button\", { name: \"退出分享\", exact: true }).click()"
    },
    {
      "action": "readAloud.click()"
    },
    {
      "action": "stopReading.click()"
    }
  ],
  "expected_outcomes": [
    "expect(page.getByText(/收到：用一句话介绍/)).toBeVisible()",
    "uiExpect.soft(page.getByTestId(\"assistant-message\").last().getByText(\"已完成\", { exact: true })).toBeVisible()",
    "uiExpect.soft(assistantMessage.getByRole(\"button\", { name: action, exact: true })).toBeVisible()",
    "expect(like).toHaveAttribute(\"aria-pressed\", \"true\")",
    "expect(like).toHaveAttribute(\"data-state\", \"selected\")",
    "expect(feedbackReasons).toBeVisible()",
    "expect(feedbackReasons).toHaveAttribute(\"data-qwork-popover-portal\", \"\")",
    "expect(feedbackReasons).toHaveAttribute(\"data-placement\", \"top\")",
    "expect(like).toHaveAttribute(\"aria-pressed\", \"false\")",
    "expect(dislike).toHaveAttribute(\"aria-pressed\", \"true\")",
    "expect(dislike).toHaveAttribute(\"data-state\", \"selected\")",
    "expect(moreMenu).toBeVisible()",
    "expect(moreMenu).toHaveAttribute(\"data-qwork-popover-portal\", \"\")",
    "expect(moreMenu).toHaveAttribute(\"data-placement\", \"top\")",
    "expect(moreMenu).toHaveCSS(\"position\", \"fixed\")",
    "expect(moreMenu.getByRole(\"menuitem\", { name: \"提交反馈\" })).toBeVisible()",
    "expect(moreMenu.getByRole(\"menuitem\", { name: \"复制请求ID\" })).toBeVisible()",
    "expect(moreMenu).toBeHidden()",
    "expect(moreFeedbackReasons).toBeVisible()",
    "expect(page.getByRole(\"status\").filter({ hasText: \"感谢反馈\" })).toBeVisible()",
    "expect(sharePanel).toBeVisible()",
    "expect(sharePanel).toHaveAttribute(\"data-no-drag\")",
    "expect(sharePanel).toHaveCSS(\"height\", \"120px\")",
    "expect(sharePanel.getByRole(\"checkbox\", { name: \"全选\" })).toBeChecked()",
    "expect(sharePanel.getByRole(\"button\", { name: \"复制链接\" })).toBeEnabled()",
    "expect(sharePanel.getByRole(\"button\", { name: \"生成二维码\" })).toBeEnabled()",
    "expect(sharePanel.getByRole(\"button\", { name: \"浏览器打开\" })).toBeEnabled()",
    "expect(sharePanel).toBeHidden()",
    "expect.poll(async () => (await stopReading.count()) + (await readAloudError.count())).toBeGreaterThan(0)",
    "expect(stopReading).toHaveAttribute(\"aria-pressed\", \"true\")",
    "expect(readAloudError).toBeVisible()",
    "uiExpect.soft(meta.getByText(/共消耗 ◇\\d+(\\.\\d+)?/)).toBeVisible()",
    "uiExpect.soft(meta.getByText(\"GLM-5.2\", { exact: true })).toBeVisible()",
    "uiExpect.soft(meta.getByText(/^\\d{2}:\\d{2}$/)).toBeVisible()",
    "uiExpect.soft(page.getByTestId(\"composer-dock\").getByRole(\"button\", { name: \"发送\", exact: true })).toBeDisabled()"
  ],
