  "expected_outcomes": [
    "expect( page.getByRole(\"status\").filter({ hasText: \"「ADHD Assistant」技能已安装，去试试\" }), ).toBeVisible()",
    "expect(picker).toContainText(\"adhd-assistant\")",
    "expect(composer).toHaveValue(\"\")",
    "expect(page.getByTestId(\"composer-editor\").getByTestId(\"selected-skill-token\")).toContainText(\"adhd-assistant\")",
    "expect(page.getByTestId(\"composer-editor\").getByTestId(\"selected-skill-token\")).toHaveCount(0)",
    "expect( page.getByTestId(\"composer-editor\").getByTestId(\"selected-skill-token\"), ).toContainText(\"adhd-assistant\")",
    "expect( page.getByText(\"收到：@adhd-assistant 帮我拆解今天的任务\", { exact: true }), ).toBeVisible()",
    "expect(page.getByRole(\"button\", { name: \"发送\", exact: true })).toBeVisible()",
    "expect( page.getByTestId(\"composer-editor\").getByTestId(\"selected-skill-token\"), ).toHaveCount(0)",
    "expect.poll(() => selectedSkillsFromLog(sidecarLog)).toEqual([ \"adhd-assistant\", ])",
    "expect.poll(() => userMessagesFromLog(sidecarLog)).toContainEqual( expect.stringMatching( /@adhd-assistant\\s+[\\s\\S]*帮我拆解今天的任务/, ), )",
    "expect( page .getByRole(\"complementary\") .getByText(\"帮我拆解今天的任务\", { exact: true }), ).toBeVisible()",
    "expect(page.getByTestId(\"message-skill-token\")).toContainText( \"adhd-assistant\", )",
    "expect( page.getByText(\"收到：这次不要使用技能\", { exact: true }), ).toBeVisible()",
    "expect(page.getByRole(\"button\", { name: \"发送\", exact: true })).toBeVisible()",
    "expect.poll(() => userMessagesFromLog(sidecarLog)).toHaveLength(2)",
    "expect((await userMessagesFromLog(sidecarLog))[1]).toMatch( /^<!-- qwork:personalization:start -->[\\s\\S]*<!-- qwork:personalization:end -->\\s+这次不要使用技能\\s+<qwork_selected_connector_invocation connectors=\"\">[\\s\\S]*<\\/qwork_selected_connector_invocation>$/, )",
    "expect(restoredHistory).toBeVisible()",
    "expect( page .getByRole(\"paragraph\") .filter({ hasText: /^帮我拆解今天的任务$/ }), ).toBeVisible()",
    "expect(page.getByTestId(\"message-skill-token\")).toContainText( \"adhd-assistant\", )",
    "expect( page.getByTestId(\"composer-editor\").getByTestId(\"selected-skill-token\"), ).toHaveCount(0)"
  ],
