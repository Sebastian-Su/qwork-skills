    },
    {
      "action": "app.close()"
    },
    {
      "action": "restarted.page .getByRole(\"complementary\") .getByRole(\"button\", { name: \"Todo 任务卡 E2E\", exact: true }) .click()"
    }
  ],
  "expected_outcomes": [
    "expect(card).toHaveCount(1)",
    "expect(card).toContainText(\"正在调研代表竞品\")",
    "expect(card).toContainText(\"状态未知\")",
    "expect(page.getByText(\"TodoWrite\", { exact: true })).toHaveCount(0)",
    "expect(processToggle).toBeVisible()",
    "expect(card).toBeVisible()",
    "expect(page.getByText(\"运行命令\", { exact: true })).toHaveCount(0)",
    "expect(card).toContainText(\"正在制定上市策略\", { timeout: 2_500 })",
    "expect(card).toContainText(\"正在完成内容样稿\")",
    "expect(card).not.toContainText(\"不应显示的输入\")",
    "expect(card.locator('[data-todo-status=\"in_progress\"]')).toHaveCount(2)",
    "expect(card.getByRole(\"button\", { name: \"展开任务列表\" })).toHaveAttribute( \"aria-expanded\", \"false\", )",
    "expect(page.getByText(\"任务已全部完成。\", { exact: true })).toBeVisible({ timeout: 3_000 })",
    "expect(card.getByRole(\"button\", { name: \"展开任务列表\" })).toHaveAttribute( \"aria-expanded\", \"false\", )",
    "expect(card.locator('[data-todo-status=\"completed\"]')).toHaveCount(3)",
    "expect(page.getByRole(\"region\", { name: \"任务列表\" })).toHaveCount(0)",
    "expect(page.getByRole(\"region\", { name: \"任务列表\" })).toContainText(\"完成内容样稿\")",
    "expect(restoredCard).toHaveCount(1)",
    "expect(restoredCard.locator('[data-todo-status=\"completed\"]')).toHaveCount(3)",
    "expect(restoredCard).toContainText(\"调研代表竞品\")",
    "expect(restarted.page.getByText(\"TodoWrite\", { exact: true })).toHaveCount(0)"
  ],
