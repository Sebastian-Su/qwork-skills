    "expect(feedback).not.toBeVisible()",
    "expect(successToast).toContainText( \"反馈提交成功，感谢您的反馈！\", )",
    "expect(successToast).toHaveCSS(\"position\", \"fixed\")",
    "expect(successToast).toHaveCSS(\"top\", \"10px\")",
    "expect.poll(() => feedbackSls.records.filter((record) => ( record.event_name === \"ui.feedback.action\" && record.feedback_source === expectedSource && record.feedback_action === \"submit\" )).length).toBe(1)",
