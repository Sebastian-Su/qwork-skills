    "expect(await computedStyle(privacy, [\"color\"])).toMatchObject({ color: theme === \"light\" ? \"rgb(20, 112, 180)\" : \"rgb(70, 168, 240)\", })",
    "expect(await computedStyle(submit, [\"background-color\", \"color\"])).toMatchObject({ \"background-color\": theme === \"light\" ? \"rgba(0, 0, 0, 0.2)\" : \"rgba(255, 255, 255, 0.2)\", color: theme === \"light\" ? \"rgb(255, 255, 255)\" : \"rgba(0, 0, 0, 0.9)\", })",
    "expect(await computedStyle(feedback, [\"border-top-width\"])).toMatchObject({ \"border-top-width\": \"0px\", })",
    "expect(await computedStyle(feedback.getByRole(\"textbox\", { name: \"反馈内容\" }), [ \"font-size\", \"line-height\", ])).toMatchObject({ \"font-size\": \"14px\", \"line-height\": \"22.4px\", })",
    "expect(feedback.getByRole(\"textbox\", { name: \"反馈内容\" })).toHaveAttribute( \"maxlength\", \"10000\", )",
    "expect(feedback.getByText(\"上传图片 (0/6)\")).toBeVisible()",
    "expect(footer.getByRole(\"checkbox\")).toBeChecked()",
    "expect(footer).toContainText( \"上传日志，仅用于排查问题，可能包含对话记录、设备信息等数据。详情请查阅隐私保护声明\", )",
