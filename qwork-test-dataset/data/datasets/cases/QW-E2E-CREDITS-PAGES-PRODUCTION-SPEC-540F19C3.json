  "expected_outcomes": [
    "expect(page.getByRole(\"dialog\", { name: \"Qwork 套餐新购\" })).toBeVisible()",
    "expect(page.getByRole(\"heading\", { name: \"在线购买暂未开放\" })).toBeVisible()",
    "expect(page.getByRole(\"button\", { name: \"暂未开放\" })).toBeDisabled()",
    "expect(page.getByText(/扫码支付|模拟支付|内测|测试积分/)).toHaveCount(0)",
    "expect(upgradeDialogBox).not.toBeNull()",
    "expect(benefitNoticeBox).not.toBeNull()",
    "expect(benefitNoticeBox!.y + benefitNoticeBox!.height).toBeLessThanOrEqual( upgradeDialogBox!.y + upgradeDialogBox!.height - 8, )",
    "expect(page.getByRole(\"region\", { name: \"Buddy 加油站\" })).toBeVisible()",
    "expect( page.getByRole(\"status\").filter({ hasText: \"领取成功，100 积分已到账\" }), ).toHaveText(\"领取成功，100 积分已到账\")",
    "expect(page.getByRole(\"button\", { name: \"今日已领\" })).toBeDisabled()",
    "expect(page.getByRole(\"textbox\", { name: /今天帮你做些什么/ })).toHaveValue(/搭建一个适合日常办公的工作台/)",
    "expect(reopenedFuelStats).toContainText(\"已领 5 天\")",
    "expect(reopenedFuelStats).toContainText(\"累计领取 500 分\")",
    "expect(reopenedFuel.getByRole(\"button\", { name: \"今日已领\" })).toBeDisabled()",
    "expect(reopenedFuel.getByRole(\"status\")).toHaveCount(0)",
    "expect(creditLedger).toBeVisible()",
    "expect(dailyClaimRow).toBeVisible()",
    "expect(rangeButton).toHaveAttribute(\"aria-pressed\", \"true\")",
    "expect(dailyClaimRow).toBeVisible()",
    "expect(grantedCredits).toContainText(\"总量： 5,100\")",
    "expect(grantedCredits).toContainText(\"剩余： 3,831.41\")",
    "expect(page.getByRole(\"dialog\", { name: \"推荐朋友使用\" })).toBeVisible()",
    "expect(page.getByRole(\"heading\", { name: \"Qwork 个人版\" })).toBeVisible()",
    "expect(page.getByRole(\"heading\", { name: \"套餐与用量\" })).toBeVisible()",
    "expect(page.getByText(\"3,831.4\", { exact: true })).toBeVisible()",
    "expect(billing).toBeVisible()",
    "expect( billing.getByRole(\"row\", { name: /每日领取.*赠送.*\\+100\\.00.*0\\.00 CNY.*已完成/ }), ).toBeVisible()",
    "expect(stage).toHaveAttribute(\"data-animation-phase\", \"ready\")",
    "expect(stage).toHaveAttribute(\"data-animation-phase\", \"done\", { timeout: 5_000 })",
    "expect(stage.getByLabel(/被窝团子动作：/)).toBeVisible()"
  ],
