  "expected_outcomes": [
    "expect .poll(async () => { const lines = (await fs.readFile(log, \"utf8\").catch(() => \"\")) .split(\"\\n\") .filter(Boolean) .map((l) => JSON.parse(l)); created = lines.find((l) => l.type === \"create_session\"); return Boolean(created); }) .toBe(true)",
    "expect( server, \"current task must receive the PDF MCP capability\", ).toBeTruthy()",
    "expect((await request(\"tools/list\", {})).result.tools[0].name).toBe( \"qwork_document_pdf\", )",
    "expect((await call(\"preflight\")).result.isError).not.toBe(true)",
    "expect(result.result.isError, JSON.stringify(result)).not.toBe(true)",
    "expect(result.result.content[0].text).toContain('\"pages\":2')",
    "expect(pdf.subarray(0, 5).toString()).toBe(\"%PDF-\")",
    "expect(normalizePdfText(text)).toContain(\"静态报告\")",
    "expect(normalizePdfText(text)).toContain(\"引用\")",
    "expect(normalizePdfText(text)).toContain( normalizePdfText(\"目录：本报告无需联网生成，网络\"), )",
    "expect(normalizePdfText(second)).toContain(\"第二页\")",
    "expect(run.result.isError, JSON.stringify(run)).not.toBe(true)",
    "expect(JSON.parse(run.result.content[0].text).pages, name).toBe(pages)",
    "expect(uncovered.result.content[0].text).toContain( \"unsupported_character\", )",
    "expect( fs.access(path.join(created.cwd, \"uncovered.pdf\")), ).rejects.toThrow()",
    "expect(missing.result.isError).toBe(true)",
    "expect(detail.code).toBe(\"pdf_text_missing\")",
    "expect(detail.message).toContain(\"字体\")",
    "expect(detail.message).toContain(\"不得自动替换字体\")",
    "expect( fs.access(path.join(created.cwd, \"missing-font.pdf\")), ).rejects.toThrow()",
    "expect(preserved.result.isError, JSON.stringify(preserved)).not.toBe( true, )",
    "expect(noto.result.content[0].text).toContain(\"pdf_text_missing\")",
    "expect( fs.access(path.join(created.cwd, \"noto.pdf\")), ).rejects.toThrow()",
    "expect(duplicate.result.isError).toBe(true)",
    "expect(duplicate.result.content[0].text).toContain(\"output_exists\")",
    "expect(await fs.readFile(path.join(created.cwd, \"report.pdf\"))).toEqual( pdf, )",
    "expect(dynamic.result.isError).toBe(true)",
    "expect(dynamic.result.content[0].text).toContain(\"dynamic_html\")",
    "expect( fs.access(path.join(created.cwd, \"dynamic.pdf\")), ).rejects.toThrow()",
    "expect(preview).toBeVisible()",
    "expect(preview).toContainText(\"1 / 2\")",
    "expect(preview.locator(\"canvas\")).toBeVisible()",
    "expect( await app.evaluate( ({ webContents }) => webContents .getAllWebContents() .filter((w) => w.getURL().startsWith(\"qwork-document-pdf://\")) .length, ), ).toBe(0)"
