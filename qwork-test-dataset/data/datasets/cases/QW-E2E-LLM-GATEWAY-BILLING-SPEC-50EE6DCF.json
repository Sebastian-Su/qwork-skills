  "expected_outcomes": [
    "expect( dock.getByRole(\"button\", { name: option.label, exact: true }), ).toBeVisible()",
    "expect( page.getByText(`模型批测成功：${providerModelId(option.value)}`, { exact: true, }), ).toBeVisible()",
    "expect( page.getByText( `共使用 ${TEST_USAGE[option.value].total.toLocaleString(\"en-US\")} Token`, { exact: true }, ), ).toBeVisible()",
    "expect(page.getByText(/NaN/)).toHaveCount(0)",
    "expect(sessionCookie).toBeDefined()",
    "expect(authCookies.map((cookie) => cookie.name)).toEqual([ \"qwork_session\", ])",
    "expect(usage.records).toHaveLength(TEST_MODEL_OPTIONS.length)",
    "expect(usage.records.map((record) => record.model).sort()).toEqual( TEST_MODEL_OPTIONS.map((option) => providerModelId(option.value), ).sort(), )",
    "expect(record.totalTokens).toBe(TEST_USAGE[record.model].total)",
    "expect(record.totalCostNanos).toBeGreaterThan(0)",
    "expect(credits.balance).toBe(4_994.83)",
    "expect(credits.ledger?.filter((entry) => entry.type === \"LLM\")).toEqual( expect.arrayContaining([ expect.objectContaining({ model: \"minimax/MiniMax-M3\", amount: -1.94, status: \"SETTLED\", }), expect.objectContaining({ model: \"deepseek/deepseek-v4-flash\", amount: -3.23, status: \"SETTLED\", }), ]), )",
    "expect(rejectedResponse!.status).toBe(429)",
    "expect((await heldRequest).ok).toBe(true)",
    "expect( creditsAfterAdmissionFailure.ledger?.find( (entry) => entry.requestId === \"e2e-credit-admission-rejected\", ), ).toMatchObject({ status: \"RELEASED\", amount: 0 })",
    "expect(accountMenu).toBeVisible()",
    "expect(page.getByRole(\"heading\", { name: \"套餐与用量\" })).toBeVisible()",
    "expect(page.getByText(\"预占已释放\", { exact: true })).toBeVisible()",
    "expect(upstream.requests).toEqual( [ ...TEST_MODEL_OPTIONS.map((option) => ({ model: providerModelId(option.value), authorization: \"Bearer server-owned-test-key\", })), { model: \"deepseek/deepseek-v4-flash\", authorization: \"Bearer server-owned-test-key\", }, ], )"
