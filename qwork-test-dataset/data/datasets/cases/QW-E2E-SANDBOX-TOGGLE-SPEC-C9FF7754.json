  "expected_outcomes": [
    "expect.poll(() => opened.page.evaluate(async () => (await window.workGui.settings.effectsReadback()).find(e => e.key === \"security.sandbox\")?.status)).toBe(\"applied\")",
    "expect(opened.page.getByRole(\"button\", { name: \"新建任务\", exact: true })).toBeVisible()",
    "expect(toggle).toBeChecked()",
    "expect(confirmation).toBeVisible()",
    "expect(toggle).toBeChecked()",
    "expect.poll(() => opened.page.evaluate(async () => (await window.workGui.settings.get()).security.sandbox.enabled)).toBe(false)",
    "expect.poll(() => opened.page.evaluate(async () => (await window.workGui.settings.effectsReadback()).find(e => e.key === \"security.sandbox\")?.effective)).toEqual({ enabled: false })",
    "expect.poll(() => opened.page.evaluate(async () => (await window.workGui.settings.effectsReadback()).find(e => e.key === \"security.sandbox\")?.effective)).toEqual({ enabled: false })",
    "expect(opened.page.getByRole(\"button\", { name: \"新建任务\", exact: true })).toBeVisible()",
    "expect(toggle).not.toBeChecked()",
    "expect(opened.page.getByRole(\"dialog\", { name: /关闭沙箱安全/ })).toHaveCount(0)",
    "expect.poll(() => opened.page.evaluate(async () => (await window.workGui.settings.effectsReadback()).find(e => e.key === \"security.sandbox\")?.effective)).toEqual({ enabled: true })"
  ],
