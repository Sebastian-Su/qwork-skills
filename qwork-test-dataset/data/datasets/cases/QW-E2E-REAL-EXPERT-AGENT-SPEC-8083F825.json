  "expected_outcomes": [
    "expect.poll(() => page.evaluate(() => window.workGui.auth.status()), { timeout: 30_000, message: \"等待真实 QUC 会话，禁止使用 E2E auth bypass\", }).toMatchObject({ loggedIn: true })",
    "expect(installedExperts.some((expert) => expert.key === \"senior-developer@experts\"), JSON.stringify(installedExperts, null, 2)).toBe(true)",
    "expect.poll(async () => { const catalog = await page.evaluate(() => window.workGui.models.list(false)); return catalog.verified && catalog.models.length > 0; }, { timeout: 30_000, intervals: [250, 500, 1_000], message: \"等待真实账号的已验证模型目录\", }).toBe(true)",
    "expect(composer).toHaveValue(prompt)",
    "expect(send).toBeEnabled({ timeout: 30_000 })",
    "expect(composer).toHaveValue(\"\", { timeout: 10_000 })",
    "expect.poll(async () => (await latestHistory(page))?.user ?? \"\", { timeout: 30_000, intervals: [250, 500, 1_000], message: \"确认本次真实任务已进入会话历史\", }).toBe(prompt)",
    "expect.poll(async () => { evidence = await latestHistory(page); if (evidence?.user !== prompt) return false; if (lastNonEmptyLine(evidence.assistant) === marker) return true; if (evidence.status === \"errored\" || evidence.status === \"cancelled\") { throw new Error( `真实任务以 ${evidence.status} 结束，未得到资格标记 ${marker}: ${evidence.assistant}`, ); } if (evidence.status === \"idle\" && evidence.assistant.trim()) { throw new Error…",
    "expect(evidence.assistant).toContain(\"REAL_AGENT_ASSISTANT_OK\")",
    "expect(evidence.user).toBe(prompt)",
    "expect(evidence.user).not.toContain(\"qwork_expert_identity\")"
  ],
