    "expect((editBox?.y ?? 0) + 2).toBeGreaterThan((bubbleBox?.y ?? 0) + (bubbleBox?.height ?? 0) - 2)",
    "expect(userMessage.getByRole(\"button\", { name: \"已复制\" })).toBeVisible()",
    "expect(userMessage.getByText(\"已复制\", { exact: true })).toHaveCount(0)",
    "expect .poll(() => page.evaluate(() => window.workGui.clipboard.readText())) .toBe(\"原始用户消息\")",
