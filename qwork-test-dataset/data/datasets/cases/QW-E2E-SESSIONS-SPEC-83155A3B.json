    "expect(composer).toHaveValue(\"修改后的用户消息\")",
    "expect(page.getByText(\"收到：修改后的用户消息\", { exact: true })).toBeVisible()",
    "expect( page.getByTestId(\"user-message\").filter({ hasText: \"原始用户消息\" }), ).toBeVisible()",
    "expect( page.getByTestId(\"user-message\").filter({ hasText: \"修改后的用户消息\" }), ).toBeVisible()"
