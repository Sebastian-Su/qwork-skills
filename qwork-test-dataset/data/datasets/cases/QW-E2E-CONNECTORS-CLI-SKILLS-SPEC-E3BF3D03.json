  "expected_outcomes": [
    "expect(dialog.getByRole(\"button\", { name: \"停用\", exact: true })).toBeVisible()",
    "expect( fs.readFile( path.join(isolatedWecomDir, \"bot.enc\"), \"utf8\", ), ).resolves.toBe(\"fixture\")",
    "expect(page.getByText(\"收到：检查四个 CLI Skill 路由\", { exact: true })).toBeVisible()",
    "expect.poll(async () => { const message = (await readJsonLines(sidecarLog)).find(({ type }) => type === \"user_message\"); return JSON.stringify(message?.content ?? \"\"); }).toContain(\"CLI 连接器\")",
    "expect(wire).toContain(`${id}（Skill：${skillId}）`)",
    "expect(wire).not.toContain(`MCP 连接器：${id}`)",
    "expect(latestSkills).toEqual(expect.arrayContaining(CASES.map(({ skillId }) => skillId)))",
    "expect(page.getByRole(\"button\", { name: \"企业微信，未连接\", exact: true })).toBeVisible()",
    "expect.poll(() => fs.access(isolatedWecomDir).then(() => true, () => false)).toBe(false)",
    "expect(fs.readFile(path.join(sharedWecomDir, \"keep\"), \"utf8\")).resolves.toBe( \"outside-qwork\", )",
    "expect(detail.getByRole(\"button\", { name: \"启用\", exact: true })).toBeVisible()",
    "expect.poll(async () => { const skills = (await readJsonLines(sidecarLog)) .filter(({ type }) => type === \"set_skills\") .at(-1)?.skills; return Array.isArray(skills) && !skills.includes(\"zsxq-cli\"); }).toBe(true)"
  ],
