  "expected_outcomes": [
    "expect(page.getByText(/积分重试验收：连接中断/)).toBeVisible()",
    "expect.poll(async () => (await messages()).some(message => message.type === \"retry_turn\")).toBe(true)",
    "expect(retry.trace_context?.trace_id).toMatch(/^[0-9a-f]{32}$/)",
    "expect(retry.trace_context.trace_id).not.toBe(original.trace_context.trace_id)",
    "expect(retry.retry_of).toBe(original.turn_id)",
    "expect(page.getByTestId(\"assistant-message\")).toContainText(\"收到：\")",
    "expect(page.getByTestId(\"assistant-message\")).toContainText(\"E2E_RETRY_CREDITS\")",
    "expect(page.getByText(\"已完成\", { exact: true })).toBeVisible()",
    "expect(await page.evaluate(() => window.workGui!.clipboard.readText())).toBe(retry.trace_context.trace_id)"
  ],
